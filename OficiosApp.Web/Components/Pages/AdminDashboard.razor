@page "/admin"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using OficiosApp.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IUsuarioService UsuarioService
@inject ICategoriaService CategoriaService
@inject IZonaService ZonaService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Panel de Administración — OficiosApp</PageTitle>

<MudThemeProvider Theme="AdminTheme" IsDarkMode="true" />

<AuthorizeView>
    <Authorized>
        @{
            var idRol = context.User.FindFirst("IdRol")?.Value;
            if (idRol != "1")
            {
                Navigation.NavigateTo("/explorar");
            }
        }

        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8 pb-16 minimal-bg">

            <!-- Header con Actualizar y Cerrar Sesión -->
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.End" Class="mb-10 flex-wrap gap-4">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.overline" Style="color: var(--mud-palette-warning); letter-spacing: 2px; font-weight: 600;">
                        Módulo Administrativo
                    </MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: 800; letter-spacing: -1px; color: #f8fafc;">
                        Panel de Control
                    </MudText>
                    <MudText Typo="Typo.subtitle1" Style="color: #94a3b8; font-weight: 300;">
                        Supervisión en tiempo real de la plataforma.
                    </MudText>
                </MudStack>

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Rounded.Refresh"
                               OnClick="CargarMetricas"
                               Disabled="@cargando"
                               Style="border-radius: 8px; text-transform: none; font-weight: 600; padding: 8px 20px;">
                        @(cargando ? "Sincronizando..." : "Actualizar Métricas")
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Rounded.Logout"
                               OnClick="CerrarSesion"
                               Class="logout-btn"
                               Style="border-radius: 8px; text-transform: none; font-weight: 600; padding: 8px 20px;">
                        Cerrar Sesión
                    </MudButton>
                </MudStack>
            </MudStack>

            <!-- Métricas Clave (3 columnas alineadas con los módulos) -->
            <MudGrid Class="mb-10" Spacing="4">

                <!-- Usuarios -->
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-6 stat-card rounded-xl" Elevation="0" Outlined="true">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                            <MudText Typo="Typo.button" Style="color: #64748b; font-weight: 600;">Usuarios</MudText>
                            <MudIcon Icon="@Icons.Material.Rounded.Group" Style="color: #475569;" Size="Size.Medium" />
                        </MudStack>
                        @if (cargando)
                        {
                            <MudSkeleton Width="60%" Height="40px" Animation="Animation.Wave" />
                            <MudSkeleton Width="90%" Height="20px" Class="mt-2" Animation="Animation.Wave" />
                        }
                        else
                        {
                            <MudText Typo="Typo.h3" Style="font-weight: 700; color: #f8fafc;">@totalUsuarios</MudText>
                            <MudText Typo="Typo.caption" Style="color: #64748b;">
                                Adm: <strong style="color: #cbd5e1;">@totalAdmins</strong> •
                                Cli: <strong style="color: #cbd5e1;">@totalClientes</strong> •
                                Pro: <strong style="color: #cbd5e1;">@totalProfesionales</strong>
                            </MudText>
                        }
                    </MudPaper>
                </MudItem>

                <!-- Categorías -->
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-6 stat-card rounded-xl" Elevation="0" Outlined="true">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                            <MudText Typo="Typo.button" Style="color: #64748b; font-weight: 600;">Categorías</MudText>
                            <MudIcon Icon="@Icons.Material.Rounded.LocalOffer" Style="color: #475569;" Size="Size.Medium" />
                        </MudStack>
                        @if (cargando)
                        {
                            <MudSkeleton Width="60%" Height="40px" Animation="Animation.Wave" />
                            <MudSkeleton Width="80%" Height="20px" Class="mt-2" Animation="Animation.Wave" />
                        }
                        else
                        {
                            <MudText Typo="Typo.h3" Style="font-weight: 700; color: #f8fafc;">@totalCategorias</MudText>
                            <MudText Typo="Typo.caption" Style="color: #64748b;">
                                <strong style="color: var(--mud-palette-warning);">@categoriasActivas</strong> activas en sistema
                            </MudText>
                        }
                    </MudPaper>
                </MudItem>

                <!-- Zonas -->
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-6 stat-card rounded-xl" Elevation="0" Outlined="true">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                            <MudText Typo="Typo.button" Style="color: #64748b; font-weight: 600;">Zonas</MudText>
                            <MudIcon Icon="@Icons.Material.Rounded.LocationOn" Style="color: #475569;" Size="Size.Medium" />
                        </MudStack>
                        @if (cargando)
                        {
                            <MudSkeleton Width="60%" Height="40px" Animation="Animation.Wave" />
                            <MudSkeleton Width="70%" Height="20px" Class="mt-2" Animation="Animation.Wave" />
                        }
                        else
                        {
                            <MudText Typo="Typo.h3" Style="font-weight: 700; color: #f8fafc;">@totalZonas</MudText>
                            <MudText Typo="Typo.caption" Style="color: #64748b;">
                                <strong style="color: var(--mud-palette-warning);">@zonasActivas</strong> habilitadas para filtro
                            </MudText>
                        }
                    </MudPaper>
                </MudItem>

            </MudGrid>

            <!-- Accesos Directos a Módulos -->
            <MudGrid Spacing="4">

                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-8 module-card rounded-xl cursor-pointer" Elevation="0" Outlined="true" @onclick="@(() => Navigation.NavigateTo("/admin/usuarios"))">
                        <div class="module-icon-wrapper mb-6">
                            <MudIcon Icon="@Icons.Material.Rounded.AdminPanelSettings" Size="Size.Large" Style="color: #94a3b8;" />
                        </div>
                        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #f8fafc;" Class="mb-3">Gestión de Usuarios</MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-6 flex-grow-1">
                            Auditoría de cuentas, modificación de roles (Admin, Cliente, Profesional) y control estricto de accesos.
                        </MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-auto action-link">
                            <MudText Typo="Typo.button" Style="font-weight: 600;">Entrar al módulo</MudText>
                            <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" Class="arrow-icon" />
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-8 module-card rounded-xl cursor-pointer" Elevation="0" Outlined="true" @onclick="@(() => Navigation.NavigateTo("/admin/categorias"))">
                        <div class="module-icon-wrapper mb-6">
                            <MudIcon Icon="@Icons.Material.Rounded.Category" Size="Size.Large" Style="color: #94a3b8;" />
                        </div>
                        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #f8fafc;" Class="mb-3">Categorías & Oficios</MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-6 flex-grow-1">
                            Alta de nuevos rubros, edición de descripciones y desactivación lógica de los oficios ofrecidos en la app.
                        </MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-auto action-link">
                            <MudText Typo="Typo.button" Style="font-weight: 600;">Entrar al módulo</MudText>
                            <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" Class="arrow-icon" />
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-8 module-card rounded-xl cursor-pointer" Elevation="0" Outlined="true" @onclick="@(() => Navigation.NavigateTo("/admin/zonas"))">
                        <div class="module-icon-wrapper mb-6">
                            <MudIcon Icon="@Icons.Material.Rounded.Map" Size="Size.Large" Style="color: #94a3b8;" />
                        </div>
                        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #f8fafc;" Class="mb-3">Zonas de Cobertura</MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-6 flex-grow-1">
                            Mantenimiento de barrios y localidades disponibles para que los profesionales configuren su alcance territorial.
                        </MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-auto action-link">
                            <MudText Typo="Typo.button" Style="font-weight: 600;">Entrar al módulo</MudText>
                            <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" Class="arrow-icon" />
                        </MudStack>
                    </MudPaper>
                </MudItem>

            </MudGrid>
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center" Style="min-height: 100vh;">
            <MudPaper Class="pa-8 text-center rounded-xl" Elevation="3" Style="background-color: #0b0f19; border: 1px solid #1e293b;">
                <MudIcon Icon="@Icons.Material.Rounded.Security" Size="Size.Large" Style="color: var(--mud-palette-error);" Class="mb-4" />
                <MudText Typo="Typo.h5" Style="font-weight: 700; color: #f8fafc;" Class="mb-2">Acceso Denegado</MudText>
                <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mb-6">Necesitás privilegios de administrador para visualizar esta sección.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Href="/login" Style="border-radius: 8px; font-weight: 700; color: #05080f;">
                    Ir a Iniciar Sesión
                </MudButton>
            </MudPaper>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

<style>
    body {
        background-color: #05080f;
        color: #f8fafc;
    }

    .minimal-bg {
        background-color: #05080f;
        min-height: 100vh;
    }

    .logout-btn:hover {
        background-color: rgba(239, 68, 68, 0.12) !important;
    }

    /* Tarjetas de estadísticas */
    .stat-card {
        background-color: #0b0f19 !important;
        border-color: #1e293b !important;
        transition: all 0.2s ease-in-out;
    }

        .stat-card:hover {
            border-color: #334155 !important;
            transform: translateY(-2px);
        }

    /* Tarjetas de Módulos (Accesos directos) */
    .module-card {
        background-color: #0a0e17 !important;
        border-color: #1e293b !important;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .module-card:hover {
            background-color: #0f172a !important;
            border-color: #475569 !important;
            transform: translateY(-6px);
            box-shadow: 0 12px 30px -10px rgba(0,0,0,0.6) !important;
        }

    .module-icon-wrapper {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: linear-gradient(135deg, #1e293b, #0f172a);
        border: 1px solid #334155;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Animación del link inferior en hover */
    .action-link {
        color: #f59e0b;
        transition: color 0.2s ease;
    }

    .arrow-icon {
        transition: transform 0.2s ease;
    }

    .module-card:hover .action-link {
        color: #fbbf24;
    }

    .module-card:hover .arrow-icon {
        transform: translateX(6px);
    }
</style>

@code {
    private MudTheme AdminTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#f59e0b",
            Secondary = "#3b82f6",
            Success = "#10b981",
            Warning = "#f59e0b",
            Error = "#ef4444",
            Background = "#05080f",
            Surface = "#0b0f19",
            AppbarBackground = "#05080f",
            TextPrimary = "#ffffff",
            TextSecondary = "#e2e8f0",
            LinesDefault = "#475569",
            LinesInputs = "#64748b",
            ActionDefault = "#cbd5e1"
        }
    };

    private bool cargando = true;

    private int totalUsuarios = 0;
    private int totalAdmins = 0;
    private int totalClientes = 0;
    private int totalProfesionales = 0;

    private int totalCategorias = 0;
    private int categoriasActivas = 0;

    private int totalZonas = 0;
    private int zonasActivas = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarMetricas();
    }

    private async Task CargarMetricas()
    {
        cargando = true;

        try
        {
            var tareaUsuarios = UsuarioService.ObtenerTodosAsync();
            var tareaCategorias = CategoriaService.ObtenerTodasAsync(soloActivas: false);
            var tareaZonas = ZonaService.ObtenerTodasAsync(soloActivas: false);

            await Task.WhenAll(tareaUsuarios, tareaCategorias, tareaZonas);

            var usuarios = await tareaUsuarios;
            var categorias = await tareaCategorias;
            var zonas = await tareaZonas;

            totalUsuarios = usuarios.Count;
            totalAdmins = usuarios.Count(u => u.IdRol == 1 || (u.Rol != null && u.Rol.Contains("Admin", StringComparison.OrdinalIgnoreCase)));
            totalClientes = usuarios.Count(u => u.IdRol == 2 || (u.Rol != null && u.Rol.Contains("Cliente", StringComparison.OrdinalIgnoreCase)));
            totalProfesionales = usuarios.Count(u => u.IdRol == 3 || (u.Rol != null && u.Rol.Contains("Profesional", StringComparison.OrdinalIgnoreCase)));

            totalCategorias = categorias.Count;
            categoriasActivas = categorias.Count(c => c.Activa);

            totalZonas = zonas.Count;
            zonasActivas = zonas.Count(z => z.Activa);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al sincronizar métricas: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CerrarSesion()
    {
        if (AuthStateProvider is CustomAuthStateProvider customAuth)
        {
            await customAuth.UpdateAuthenticationState(null);
        }

        Navigation.NavigateTo("/login", replace: true);
    }
}