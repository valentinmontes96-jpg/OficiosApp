@page "/admin/usuarios"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using OficiosApp.Shared.Dtos.Usuarios
@using OficiosApp.Web.Services
@using MudBlazor
@inject IUsuarioService UsuarioService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Usuarios — OficiosApp</PageTitle>

<MudThemeProvider Theme="AdminTheme" IsDarkMode="true" />
<MudPopoverProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        @{
            var idRol = context.User.FindFirst("IdRol")?.Value;
            if (idRol != "1")
            {
                Navigation.NavigateTo("/explorar");
            }
        }

        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8 pb-16 minimal-bg">

            <!-- Header y KPIs rápidos -->
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.End" Class="mb-6 flex-wrap gap-4">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.overline" Style="color: #f59e0b; letter-spacing: 2px; font-weight: 600;">
                        Administración
                    </MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: 800; letter-spacing: -1px; color: #f8fafc;">
                        Cuentas y Accesos
                    </MudText>
                    <MudText Typo="Typo.subtitle1" Style="color: #94a3b8; font-weight: 300;">
                        Directorio centralizado de usuarios, roles y permisos de la plataforma.
                    </MudText>
                </MudStack>

                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                    <MudChip T="string" Style="background-color: #0f172a; border: 1px solid #334155; color: #cbd5e1;">
                        Total: <strong class="ms-1" style="color: #ffffff;">@usuarios.Count</strong>
                    </MudChip>
                    <MudChip T="string" Style="background-color: rgba(220, 38, 38, 0.1); border: 1px solid rgba(220, 38, 38, 0.25); color: #f87171;">
                        Admins: <strong class="ms-1">@usuarios.Count(u => ResolverIdRol(u) == 1)</strong>
                    </MudChip>
                    <MudChip T="string" Style="background-color: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); color: #fbbf24;">
                        Profesionales: <strong class="ms-1">@usuarios.Count(u => ResolverIdRol(u) == 3)</strong>
                    </MudChip>
                    <MudChip T="string" Style="background-color: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25); color: #38bdf8;">
                        Clientes: <strong class="ms-1">@usuarios.Count(u => ResolverIdRol(u) == 2)</strong>
                    </MudChip>
                </MudStack>
            </MudStack>

            <!-- Barra de Búsqueda y Filtro por Rol -->
            <MudPaper Class="pa-4 mb-6 filter-bar rounded-xl" Elevation="0" Outlined="true">
                <MudGrid Spacing="3" AlignItems="AlignItems.Center">
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="filtroTexto"
                                      Placeholder="Buscar por nombre, apellido, email, teléfono o #ID..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Rounded.Search"
                                      Clearable="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" sm="8" md="4">
                        <MudSelect T="int"
                                   @bind-Value="filtroIdRol"
                                   Label="Filtrar por Rol"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Rounded.FilterList">
                            <MudSelectItem Value="0">Todos los roles</MudSelectItem>
                            <MudSelectItem Value="1">Administradores</MudSelectItem>
                            <MudSelectItem Value="3">Profesionales</MudSelectItem>
                            <MudSelectItem Value="2">Clientes</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4" md="2" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Rounded.Refresh"
                                   OnClick="CargarUsuarios"
                                   Disabled="@cargando"
                                   FullWidth="true"
                                   Class="action-btn py-2">
                            Actualizar
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Tabla de Alta Densidad para Muchos Usuarios -->
            <MudTable Items="@usuariosFiltrados"
                      Dense="true"
                      Hover="true"
                      Striped="false"
                      Loading="@cargando"
                      LoadingProgressColor="Color.Warning"
                      Elevation="0"
                      Outlined="true"
                      Class="users-table rounded-xl overflow-hidden"
                      RowsPerPage="15">
                <HeaderContent>
                    <MudTh Style="width: 90px;">
                        <MudTableSortLabel SortBy="new Func<UsuarioDto, object>(x => x.IdUsuario)">ID</MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<UsuarioDto, object>(x => x.Nombre ?? string.Empty)">Usuario</MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<UsuarioDto, object>(x => x.Email ?? string.Empty)">Correo Electrónico</MudTableSortLabel>
                    </MudTh>
                    <MudTh>Teléfono</MudTh>
                    <MudTh Style="width: 170px;">
                        <MudTableSortLabel SortBy="new Func<UsuarioDto, object>(x => ResolverIdRol(x))">Rol</MudTableSortLabel>
                    </MudTh>
                    <MudTh Style="width: 130px; text-align: right;">Acciones</MudTh>
                </HeaderContent>

                <RowTemplate Context="u">
                    <MudTd DataLabel="ID">
                        <span class="id-badge">#@u.IdUsuario</span>
                    </MudTd>

                    <MudTd DataLabel="Usuario">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudAvatar Size="Size.Small" Style="background: linear-gradient(135deg, #1e293b, #0f172a); border: 1px solid #475569; color: #f59e0b; font-weight: 700; font-size: 0.78rem;">
                                @(u.Nombre?.FirstOrDefault())@(u.Apellido?.FirstOrDefault())
                            </MudAvatar>
                            <MudText Typo="Typo.body2" Style="font-weight: 600; color: #f8fafc;">
                                @u.Nombre @u.Apellido
                            </MudText>
                        </MudStack>
                    </MudTd>

                    <MudTd DataLabel="Correo Electrónico">
                        <MudText Typo="Typo.body2" Style="color: #cbd5e1;">@u.Email</MudText>
                    </MudTd>

                    <MudTd DataLabel="Teléfono">
                        @if (!string.IsNullOrWhiteSpace(u.Telefono))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Rounded.PhoneIphone" Size="Size.Small" Style="color: #64748b; font-size: 1rem;" />
                                <MudText Typo="Typo.caption" Style="color: #e2e8f0; font-family: monospace; font-size: 0.82rem;">@u.Telefono</MudText>
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Style="color: #64748b;">—</MudText>
                        }
                    </MudTd>

                    <MudTd DataLabel="Rol">
                        @{
                            var rolId = ResolverIdRol(u);
                        }
                        @if (rolId == 1)
                        {
                            <MudChip T="string" Size="Size.Small" Style="background-color: rgba(220, 38, 38, 0.12); color: #f87171; border: 1px solid rgba(220, 38, 38, 0.3); font-weight: 600;">
                                Administrador
                            </MudChip>
                        }
                        else if (rolId == 3)
                        {
                            <MudChip T="string" Size="Size.Small" Style="background-color: rgba(245, 158, 11, 0.12); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); font-weight: 600;">
                                Profesional
                            </MudChip>
                        }
                        else if (rolId == 2)
                        {
                            <MudChip T="string" Size="Size.Small" Style="background-color: rgba(56, 189, 248, 0.12); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); font-weight: 600;">
                                Cliente
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Style="background-color: rgba(148, 163, 184, 0.12); color: #cbd5e1; border: 1px solid rgba(148, 163, 184, 0.3); font-weight: 600;">
                                @(string.IsNullOrWhiteSpace(u.Rol) ? "Sin Rol" : u.Rol)
                            </MudChip>
                        }
                    </MudTd>

                    <MudTd DataLabel="Acciones" Style="text-align: right;">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                           Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Class="action-btn"
                                           Title="Editar cuenta"
                                           OnClick="@(() => AbrirModalEdicion(u))" />
                            <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline"
                                           Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Class="danger-btn"
                                           Title="Eliminar cuenta"
                                           OnClick="@(() => EliminarUsuario(u.IdUsuario))" />
                        </MudStack>
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-12">
                        <MudIcon Icon="@Icons.Material.Rounded.PersonSearch" Style="color: #475569; font-size: 3.5rem;" />
                        <MudText Typo="Typo.h6" Style="color: #f8fafc;" Class="mt-2">No se encontraron usuarios</MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8;">Probá ajustando el texto de búsqueda o el filtro de rol.</MudText>
                    </MudStack>
                </NoRecordsContent>

                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 15, 30, 50, 100 }"
                                   RowsPerPageString="Usuarios por página:"
                                   InfoFormat="{first_item}-{last_item} de {all_items}" />
                </PagerContent>
            </MudTable>

        </MudContainer>

        <!-- Modal con MudOverlay -->
        <MudOverlay Visible="mostrarModal" DarkBackground="true" Absolute="false" ZIndex="1300">
            <MudPaper Class="pa-6 modal-paper rounded-xl" Outlined="true" Elevation="24" Style="width: 92vw; max-width: 540px;">

                <!-- Encabezado del Modal -->
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-4 mb-5" Style="border-bottom: 1px solid #334155;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Rounded.ManageAccounts" Style="color: #f59e0b;" />
                        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc;">
                            Editar Cuenta #@idSeleccionado
                        </MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" OnClick="CerrarModal" Style="color: #cbd5e1;" />
                </MudStack>

                <!-- Cuerpo del Modal -->
                <MudStack Spacing="4" Class="mb-6 text-start">
                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Style="border-radius: 8px;">
                            @mensajeError
                        </MudAlert>
                    }

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="formNombre"
                                          Label="Nombre *"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="formApellido"
                                          Label="Apellido *"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>

                    <MudTextField Value="emailSeleccionado"
                                  Label="Correo Electrónico (No editable)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  ReadOnly="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Rounded.Lock" />

                    <MudTextField @bind-Value="formTelefono"
                                  Label="Teléfono *"
                                  Placeholder="+54 9 ..."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Rounded.PhoneIphone" />

                    <!-- Selector directo de Rol (No usa Popover y permite cambiar con 1 clic) -->
                    <div>
                        <MudText Typo="Typo.caption" Style="color: #e2e8f0; font-weight: 600; display: block; margin-bottom: 8px;">
                            Rol de Acceso *
                        </MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="4">
                                <MudButton FullWidth="true"
                                           Variant="@(formIdRol == 1 ? Variant.Filled : Variant.Outlined)"
                                           Color="@(formIdRol == 1 ? Color.Error : Color.Default)"
                                           OnClick="@(() => formIdRol = 1)"
                                           Class="@(formIdRol == 1 ? "role-btn-active" : "role-btn")"
                                           StartIcon="@Icons.Material.Rounded.Security">
                                    Admin
                                </MudButton>
                            </MudItem>
                            <MudItem xs="4">
                                <MudButton FullWidth="true"
                                           Variant="@(formIdRol == 2 ? Variant.Filled : Variant.Outlined)"
                                           Color="@(formIdRol == 2 ? Color.Info : Color.Default)"
                                           OnClick="@(() => formIdRol = 2)"
                                           Class="@(formIdRol == 2 ? "role-btn-active" : "role-btn")"
                                           StartIcon="@Icons.Material.Rounded.Person">
                                    Cliente
                                </MudButton>
                            </MudItem>
                            <MudItem xs="4">
                                <MudButton FullWidth="true"
                                           Variant="@(formIdRol == 3 ? Variant.Filled : Variant.Outlined)"
                                           Color="@(formIdRol == 3 ? Color.Warning : Color.Default)"
                                           OnClick="@(() => formIdRol = 3)"
                                           Class="@(formIdRol == 3 ? "role-btn-active-pro" : "role-btn")"
                                           StartIcon="@Icons.Material.Rounded.Handyman">
                                    Profesional
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </div>

                    <MudSwitch @bind-Value="formActivo"
                               Color="Color.Success"
                               Label="Cuenta Activa (Puede iniciar sesión)"
                               Style="color: #e2e8f0;" />
                </MudStack>

                <!-- Acciones del Modal -->
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="pt-4" Style="border-top: 1px solid #334155;">
                    <MudButton OnClick="CerrarModal" Disabled="@guardando" Style="color: #cbd5e1; text-transform: none;">
                        Cancelar
                    </MudButton>
                    <MudButton Color="Color.Warning"
                               Variant="Variant.Filled"
                               OnClick="GuardarUsuario"
                               Disabled="@guardando"
                               Style="font-weight: 700; color: #05080f; text-transform: none; border-radius: 8px;">
                        @if (guardando)
                        {
                            <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true" Style="color: #05080f;" />
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Cambios</span>
                        }
                    </MudButton>
                </MudStack>

            </MudPaper>
        </MudOverlay>

    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center" Style="min-height: 100vh;">
            <MudPaper Class="pa-8 text-center rounded-xl" Elevation="3" Style="background-color: #0b0f19; border: 1px solid #1e293b;">
                <MudIcon Icon="@Icons.Material.Rounded.Security" Size="Size.Large" Style="color: var(--mud-palette-error);" Class="mb-4" />
                <MudText Typo="Typo.h5" Style="font-weight: 700; color: #f8fafc;" Class="mb-2">Acceso Denegado</MudText>
                <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mb-6">Necesitás privilegios de administrador para visualizar esta sección.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Href="/login" Style="border-radius: 8px; font-weight: 700; color: #05080f;">
                    Ir a Iniciar Sesión
                </MudButton>
            </MudPaper>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

<style>
    body {
        background-color: #05080f;
        color: #f8fafc;
    }

    .minimal-bg {
        background-color: #05080f;
        min-height: 100vh;
    }

    .filter-bar {
        background-color: #0b0f19 !important;
        border-color: #1e293b !important;
    }

    /* Asegura que cualquier desplegable de MudBlazor quede por encima de los Overlays */
    .mud-popover-cascading-value,
    .mud-popover {
        z-index: 2000 !important;
    }

    /* Botones de selección de rol en el modal */
    .role-btn {
        background-color: #1e293b !important;
        border-color: #475569 !important;
        color: #cbd5e1 !important;
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 8px !important;
        padding: 8px 10px !important;
    }

    .role-btn-active {
        text-transform: none !important;
        font-weight: 700 !important;
        border-radius: 8px !important;
        padding: 8px 10px !important;
        color: #ffffff !important;
    }

    .role-btn-active-pro {
        text-transform: none !important;
        font-weight: 700 !important;
        border-radius: 8px !important;
        padding: 8px 10px !important;
        color: #05080f !important;
    }

    /* Estilos de la Tabla de Alta Densidad */
    .users-table {
        background-color: #0b0f19 !important;
        border-color: #1e293b !important;
    }

        .users-table .mud-table-head .mud-table-cell {
            background-color: #0f172a !important;
            color: #cbd5e1 !important;
            font-weight: 700 !important;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #1e293b !important;
        }

        .users-table .mud-table-body .mud-table-cell {
            border-bottom: 1px solid rgba(30, 41, 59, 0.6) !important;
            padding-top: 10px !important;
            padding-bottom: 10px !important;
        }

        .users-table .mud-table-row:hover {
            background-color: rgba(30, 41, 59, 0.45) !important;
        }

    .id-badge {
        font-family: monospace;
        font-size: 0.8rem;
        color: #94a3b8;
        background-color: #0f172a;
        border: 1px solid #1e293b;
        padding: 2px 8px;
        border-radius: 6px;
    }

    .modal-paper {
        background-color: #0b0f19 !important;
        border-color: #334155 !important;
    }

    .action-btn {
        border-color: #334155 !important;
        color: #e2e8f0 !important;
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 8px !important;
    }

        .action-btn:hover {
            background-color: #1e293b !important;
            color: #ffffff !important;
        }

    .danger-btn {
        border-color: #334155 !important;
        color: #ef4444 !important;
        border-radius: 8px !important;
    }

        .danger-btn:hover {
            background-color: rgba(239, 68, 68, 0.12) !important;
            border-color: rgba(239, 68, 68, 0.35) !important;
        }

    /* === ALTO CONTRASTE UNIFICADO PARA TODOS LOS INPUTS === */
    .mud-input-control > .mud-input-control-input-container > div.mud-input.mud-input-outlined {
        background-color: #1e293b !important;
        border-radius: 8px !important;
    }

    .mud-input-outlined-border {
        border-color: #475569 !important;
        border-width: 1.5px !important;
    }

    .mud-input-control:hover .mud-input-outlined-border {
        border-color: #94a3b8 !important;
    }

    .mud-input.mud-input-outlined.mud-input-focused .mud-input-outlined-border {
        border-color: #f59e0b !important;
        border-width: 2px !important;
    }

    .mud-input > input.mud-input-root,
    .mud-input > textarea.mud-input-root,
    div.mud-input-slot.mud-input-root {
        color: #ffffff !important;
        font-weight: 500 !important;
    }

        .mud-input > input.mud-input-root::placeholder,
        .mud-input > textarea.mud-input-root::placeholder {
            color: #94a3b8 !important;
            opacity: 1 !important;
        }

    .mud-input-label {
        color: #e2e8f0 !important;
        font-weight: 600 !important;
        background-color: transparent !important;
    }

    .mud-input-control.mud-input-focused .mud-input-label {
        color: #f59e0b !important;
    }

    .mud-input-adornment .mud-icon-root,
    .mud-input-adornment button {
        color: #cbd5e1 !important;
    }
</style>

@code {
    private MudTheme AdminTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#f59e0b",
            Secondary = "#3b82f6",
            Success = "#10b981",
            Warning = "#f59e0b",
            Error = "#ef4444",
            Background = "#05080f",
            Surface = "#0b0f19",
            AppbarBackground = "#05080f",
            TextPrimary = "#ffffff",
            TextSecondary = "#e2e8f0",
            LinesDefault = "#475569",
            LinesInputs = "#64748b",
            ActionDefault = "#cbd5e1"
        }
    };

    private List<UsuarioDto> usuarios = new();
    private string filtroTexto = string.Empty;
    private int filtroIdRol = 0;
    private bool cargando = true;
    private bool guardando = false;

    private bool mostrarModal = false;
    private int idSeleccionado = 0;
    private string emailSeleccionado = string.Empty;
    private string formNombre = string.Empty;
    private string formApellido = string.Empty;
    private string formTelefono = string.Empty;
    private int formIdRol = 2;
    private bool formActivo = true;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        cargando = true;
        try
        {
            usuarios = await UsuarioService.ObtenerTodosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar usuarios: {ex.Message}");
            usuarios = new List<UsuarioDto>();
        }
        finally
        {
            cargando = false;
        }
    }

    /// <summary>
    /// Interpreta el rol del UsuarioDto tanto si viene como texto ("Admin", "Profesional", "Cliente")
    /// como si viene como número en string ("1", "2", "3").
    /// </summary>
    private int ResolverIdRol(UsuarioDto u)
    {
        if (string.IsNullOrWhiteSpace(u.Rol))
            return 0;

        var r = u.Rol.Trim();

        if (r == "1" || r.Contains("Admin", StringComparison.OrdinalIgnoreCase))
            return 1;

        if (r == "3" || r.Contains("Pro", StringComparison.OrdinalIgnoreCase))
            return 3;

        if (r == "2" || r.Contains("Cli", StringComparison.OrdinalIgnoreCase))
            return 2;

        return 0;
    }

    private List<UsuarioDto> usuariosFiltrados
    {
        get
        {
            var resultado = usuarios.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filtroTexto))
            {
                var f = filtroTexto.Trim().ToLower();
                resultado = resultado.Where(u =>
                    u.IdUsuario.ToString().Contains(f) ||
                    (u.Nombre != null && u.Nombre.ToLower().Contains(f)) ||
                    (u.Apellido != null && u.Apellido.ToLower().Contains(f)) ||
                    (u.Email != null && u.Email.ToLower().Contains(f)) ||
                    (u.Telefono != null && u.Telefono.ToLower().Contains(f))
                );
            }

            if (filtroIdRol != 0)
            {
                resultado = resultado.Where(u => ResolverIdRol(u) == filtroIdRol);
            }

            return resultado.ToList();
        }
    }

    private void AbrirModalEdicion(UsuarioDto usuario)
    {
        idSeleccionado = usuario.IdUsuario;
        emailSeleccionado = usuario.Email;
        formNombre = usuario.Nombre;
        formApellido = usuario.Apellido;
        formTelefono = usuario.Telefono ?? string.Empty;

        var rolDetectado = ResolverIdRol(usuario);
        formIdRol = rolDetectado != 0 ? rolDetectado : 2;

        formActivo = true;
        mensajeError = null;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        mensajeError = null;
    }

    private async Task GuardarUsuario()
    {
        if (string.IsNullOrWhiteSpace(formNombre) || string.IsNullOrWhiteSpace(formApellido))
        {
            mensajeError = "Nombre y apellido son obligatorios.";
            return;
        }
        if (string.IsNullOrWhiteSpace(formTelefono))
        {
            mensajeError = "El teléfono es obligatorio.";
            return;
        }

        guardando = true;
        mensajeError = null;

        try
        {
            var dto = new ActualizarUsuarioAdminDto
            {
                Nombre = formNombre.Trim(),
                Apellido = formApellido.Trim(),
                Telefono = formTelefono.Trim(),
                IdRol = formIdRol,
                Activo = formActivo
            };

            var ok = await UsuarioService.ActualizarAsync(idSeleccionado, dto);
            if (ok)
            {
                mostrarModal = false;
                Snackbar.Add("Usuario actualizado correctamente.", Severity.Success);
                usuarios = await UsuarioService.ObtenerTodosAsync();
            }
            else
            {
                mensajeError = "No se pudo actualizar el usuario. Verificá permisos o validaciones del servidor.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarUsuario(int id)
    {
        var ok = await UsuarioService.EliminarAsync(id);
        if (ok)
        {
            Snackbar.Add("Usuario eliminado con éxito.", Severity.Info);
            usuarios = await UsuarioService.ObtenerTodosAsync();
        }
        else
        {
            Snackbar.Add("Error al eliminar el usuario.", Severity.Error);
        }
    }
}