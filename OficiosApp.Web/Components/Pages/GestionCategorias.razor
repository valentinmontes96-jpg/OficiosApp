@page "/admin/categorias"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using OficiosApp.Shared.Dtos.Categoria
@using OficiosApp.Web.Services
@using MudBlazor
@inject ICategoriaService CategoriaService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Gestión de Categorías — OficiosApp</PageTitle>

<MudThemeProvider Theme="AdminTheme" IsDarkMode="true" />
<MudPopoverProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        @{
            var idRol = context.User.FindFirst("IdRol")?.Value;
            if (idRol != "1")
            {
                Navigation.NavigateTo("/explorar");
            }
        }

        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8 pb-16 minimal-bg">

            <!-- Encabezado y Acción Principal -->
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.End" Class="mb-6 flex-wrap gap-4">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.overline" Style="color: #f59e0b; letter-spacing: 2px; font-weight: 600;">
                        Módulo Admin
                    </MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: 800; letter-spacing: -1px; color: #f8fafc;">
                        Categorías & Oficios
                    </MudText>
                    <MudText Typo="Typo.subtitle1" Style="color: #94a3b8; font-weight: 300;">
                        Administrá los rubros de trabajo y servicios disponibles en el sistema.
                    </MudText>
                </MudStack>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Rounded.Add"
                           OnClick="AbrirModalCreacion"
                           Class="px-5 py-2"
                           Style="border-radius: 10px; font-weight: 700; text-transform: none; color: #05080f;">
                    Nueva Categoría
                </MudButton>
            </MudStack>

            <!-- Barra de Filtros y Métricas -->
            <MudPaper Class="pa-4 mb-6 filter-bar rounded-xl" Elevation="0" Outlined="true">
                <MudGrid Spacing="3" AlignItems="AlignItems.Center">
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="filtroTexto"
                                      Placeholder="Buscar por nombre, descripción o #ID..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Rounded.Search"
                                      Clearable="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" md="6" Class="d-flex justify-end align-center flex-wrap gap-3">
                        <MudSwitch T="bool"
                                   Value="soloActivas"
                                   ValueChanged="OnSoloActivasChanged"
                                   Color="Color.Success"
                                   Label="Solo activas"
                                   Style="color: #e2e8f0;" />

                        <MudChip T="string" Style="background-color: #0f172a; border: 1px solid #334155; color: #cbd5e1;">
                            Total: <strong class="ms-1" style="color: #ffffff;">@categoriasFiltradas.Count</strong>
                        </MudChip>

                        <MudChip T="string" Style="background-color: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); color: #34d399;">
                            Activas: <strong class="ms-1">@categoriasFiltradas.Count(c => c.Activa)</strong>
                        </MudChip>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Tabla de Categorías -->
            <MudTable Items="@categoriasFiltradas"
                      Dense="true"
                      Hover="true"
                      Striped="false"
                      Loading="@cargando"
                      LoadingProgressColor="Color.Warning"
                      Elevation="0"
                      Outlined="true"
                      Class="categories-table rounded-xl overflow-hidden"
                      RowsPerPage="15">
                <HeaderContent>
                    <MudTh Style="width: 90px;">
                        <MudTableSortLabel SortBy="new Func<CategoriaResponseDto, object>(x => x.IdCategoria)">ID</MudTableSortLabel>
                    </MudTh>
                    <MudTh Style="width: 80px;">Ícono</MudTh>
                    <MudTh Style="width: 240px;">
                        <MudTableSortLabel SortBy="new Func<CategoriaResponseDto, object>(x => x.Nombre ?? string.Empty)">Nombre</MudTableSortLabel>
                    </MudTh>
                    <MudTh>Descripción</MudTh>
                    <MudTh Style="width: 130px; text-align: center;">
                        <MudTableSortLabel SortBy="new Func<CategoriaResponseDto, object>(x => x.Activa)">Estado</MudTableSortLabel>
                    </MudTh>
                    <MudTh Style="width: 130px; text-align: right;">Acciones</MudTh>
                </HeaderContent>

                <RowTemplate Context="cat">
                    <MudTd DataLabel="ID">
                        <span class="id-badge">#@cat.IdCategoria</span>
                    </MudTd>

                    <MudTd DataLabel="Ícono">
                        <MudAvatar Size="Size.Small" Style="background: linear-gradient(135deg, #1e293b, #0f172a); border: 1px solid #475569; color: #f59e0b;">
                            @if (!string.IsNullOrWhiteSpace(cat.IconoUrl))
                            {
                                @if (cat.IconoUrl.StartsWith("http") || cat.IconoUrl.StartsWith("/"))
                                {
                                    <MudImage Src="@cat.IconoUrl" Alt="@cat.Nombre" Width="20" Height="20" ObjectFit="ObjectFit.Contain" />
                                }
                                else
                                {
                                    <span style="font-size: 1rem;">@cat.IconoUrl</span>
                                }
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Rounded.Handyman" Size="Size.Small" />
                            }
                        </MudAvatar>
                    </MudTd>

                    <MudTd DataLabel="Nombre">
                        <MudText Typo="Typo.body2" Style="font-weight: 700; color: #f8fafc;">
                            @cat.Nombre
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="Descripción">
                        <MudText Typo="Typo.body2" Style="color: #cbd5e1;">
                            @(string.IsNullOrWhiteSpace(cat.Descripcion) ? "—" : cat.Descripcion)
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="Estado" Style="text-align: center;">
                        @if (cat.Activa)
                        {
                            <MudChip T="string" Size="Size.Small" Style="background-color: rgba(16, 185, 129, 0.12); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); font-weight: 600;">
                                Activa
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Style="background-color: rgba(239, 68, 68, 0.12); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); font-weight: 600;">
                                Inactiva
                            </MudChip>
                        }
                    </MudTd>

                    <MudTd DataLabel="Acciones" Style="text-align: right;">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                           Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Class="action-btn"
                                           Title="Editar categoría"
                                           OnClick="@(() => AbrirModalEdicion(cat))" />
                            <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline"
                                           Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Class="danger-btn"
                                           Title="Eliminar categoría"
                                           OnClick="@(() => EliminarCategoria(cat.IdCategoria))" />
                        </MudStack>
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-12">
                        <MudIcon Icon="@Icons.Material.Rounded.Category" Style="color: #475569; font-size: 3.5rem;" />
                        <MudText Typo="Typo.h6" Style="color: #f8fafc;" Class="mt-2">No se encontraron categorías</MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8;">Podés registrar un nuevo rubro usando el botón superior.</MudText>
                    </MudStack>
                </NoRecordsContent>

                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 15, 30, 50, 100 }"
                                   RowsPerPageString="Categorías por página:"
                                   InfoFormat="{first_item}-{last_item} de {all_items}" />
                </PagerContent>
            </MudTable>

        </MudContainer>

        <!-- Modal con MudOverlay (Sin bloqueo de circuito y con alto contraste) -->
        <MudOverlay Visible="mostrarModal" DarkBackground="true" Absolute="false" ZIndex="1300">
            <MudPaper Class="pa-6 modal-paper rounded-xl" Outlined="true" Elevation="24" Style="width: 92vw; max-width: 520px;">

                <!-- Encabezado del Modal -->
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-4 mb-5" Style="border-bottom: 1px solid #334155;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@(esEdicion ? Icons.Material.Rounded.EditNote : Icons.Material.Rounded.AddBox)" Style="color: #f59e0b;" />
                        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc;">
                            @(esEdicion ? $"Editar Categoría #{idSeleccionado}" : "Nueva Categoría")
                        </MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" OnClick="CerrarModal" Style="color: #cbd5e1;" />
                </MudStack>

                <!-- Cuerpo del Modal -->
                <MudStack Spacing="4" Class="mb-6 text-start">
                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Style="border-radius: 8px;">
                            @mensajeError
                        </MudAlert>
                    }

                    <MudTextField @bind-Value="formNombre"
                                  Label="Nombre * (máx 80 car.)"
                                  Placeholder="Ej: Plomería, Electricidad, Gasista"
                                  MaxLength="80"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Rounded.Label" />

                    <MudTextField @bind-Value="formIconoUrl"
                                  Label="Ícono / Emoji (máx 255 car.)"
                                  Placeholder="Ej: 🔧 o URL de imagen"
                                  MaxLength="255"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Rounded.EmojiEmotions" />

                    <MudTextField @bind-Value="formDescripcion"
                                  Label="Descripción (máx 255 car.)"
                                  Placeholder="Detalle de trabajos incluidos en este rubro..."
                                  MaxLength="255"
                                  Lines="3"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />

                    @if (esEdicion)
                    {
                        <MudSwitch @bind-Value="formActiva"
                                   Color="Color.Success"
                                   Label="Categoría Activa en la Plataforma"
                                   Style="color: #e2e8f0;" />
                    }
                </MudStack>

                <!-- Acciones del Modal -->
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="pt-4" Style="border-top: 1px solid #334155;">
                    <MudButton OnClick="CerrarModal" Disabled="@guardando" Style="color: #cbd5e1; text-transform: none;">
                        Cancelar
                    </MudButton>
                    <MudButton Color="Color.Warning"
                               Variant="Variant.Filled"
                               OnClick="GuardarCategoria"
                               Disabled="@guardando"
                               Style="font-weight: 700; color: #05080f; text-transform: none; border-radius: 8px;">
                        @if (guardando)
                        {
                            <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true" Style="color: #05080f;" />
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>@(esEdicion ? "Guardar Cambios" : "Crear Categoría")</span>
                        }
                    </MudButton>
                </MudStack>

            </MudPaper>
        </MudOverlay>

    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center" Style="min-height: 100vh;">
            <MudPaper Class="pa-8 text-center rounded-xl" Elevation="3" Style="background-color: #0b0f19; border: 1px solid #1e293b;">
                <MudIcon Icon="@Icons.Material.Rounded.Security" Size="Size.Large" Style="color: var(--mud-palette-error);" Class="mb-4" />
                <MudText Typo="Typo.h5" Style="font-weight: 700; color: #f8fafc;" Class="mb-2">Acceso Denegado</MudText>
                <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mb-6">Necesitás privilegios de administrador para visualizar esta sección.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Href="/login" Style="border-radius: 8px; font-weight: 700; color: #05080f;">
                    Ir a Iniciar Sesión
                </MudButton>
            </MudPaper>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

<style>
