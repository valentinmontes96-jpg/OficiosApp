@code {
    private MudTheme AdminTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#f59e0b",
            Secondary = "#3b82f6",
            Success = "#10b981",
            Warning = "#f59e0b",
            Error = "#ef4444",
            Background = "#05080f",
            Surface = "#0b0f19",
            AppbarBackground = "#05080f",
            TextPrimary = "#ffffff",
            TextSecondary = "#e2e8f0",
            LinesDefault = "#475569",
            LinesInputs = "#64748b",
            ActionDefault = "#cbd5e1"
        }
    };

    private List<CategoriaResponseDto> categorias = new();
    private string filtroTexto = string.Empty;
    private bool soloActivas = false;
    private bool cargando = true;
    private bool guardando = false;

    // Estado del modal
    private bool mostrarModal = false;
    private bool esEdicion = false;
    private int idSeleccionado = 0;
    private string formNombre = string.Empty;
    private string? formIconoUrl;
    private string? formDescripcion;
    private bool formActiva = true;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }

    private async Task OnSoloActivasChanged(bool valor)
    {
        soloActivas = valor;
        await CargarCategorias();
    }

    private async Task CargarCategorias()
    {
        cargando = true;
        try
        {
            categorias = await CategoriaService.ObtenerTodasAsync(soloActivas);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al consultar categorías: {ex.Message}");
            categorias = new List<CategoriaResponseDto>();
        }
        finally
        {
            cargando = false;
        }
    }

    private List<CategoriaResponseDto> categoriasFiltradas
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filtroTexto))
                return categorias;

            var f = filtroTexto.Trim().ToLower();
            return categorias.Where(c =>
                c.IdCategoria.ToString().Contains(f) ||
                (c.Nombre != null && c.Nombre.ToLower().Contains(f)) ||
                (c.Descripcion != null && c.Descripcion.ToLower().Contains(f))
            ).ToList();
        }
    }

    private void AbrirModalCreacion()
    {
        esEdicion = false;
        idSeleccionado = 0;
        formNombre = string.Empty;
        formIconoUrl = null;
        formDescripcion = null;
        formActiva = true;
        mensajeError = null;
        mostrarModal = true;
    }

    private void AbrirModalEdicion(CategoriaResponseDto cat)
    {
        esEdicion = true;
        idSeleccionado = cat.IdCategoria;
        formNombre = cat.Nombre;
        formIconoUrl = cat.IconoUrl;
        formDescripcion = cat.Descripcion;
        formActiva = cat.Activa;
        mensajeError = null;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        mensajeError = null;
    }

    private async Task GuardarCategoria()
    {
        if (string.IsNullOrWhiteSpace(formNombre))
        {
            mensajeError = "El nombre de la categoría es obligatorio.";
            return;
        }

        guardando = true;
        mensajeError = null;

        try
        {
            bool ok;
            if (esEdicion)
            {
                var dto = new ActualizarCategoriaDto
                {
                    Nombre = formNombre.Trim(),
                    Descripcion = string.IsNullOrWhiteSpace(formDescripcion) ? null : formDescripcion.Trim(),
                    IconoUrl = string.IsNullOrWhiteSpace(formIconoUrl) ? null : formIconoUrl.Trim(),
                    Activa = formActiva
                };

                ok = await CategoriaService.ActualizarAsync(idSeleccionado, dto);
            }
            else
            {
                var dto = new CrearCategoriaDto
                {
                    Nombre = formNombre.Trim(),
                    Descripcion = string.IsNullOrWhiteSpace(formDescripcion) ? null : formDescripcion.Trim(),
                    IconoUrl = string.IsNullOrWhiteSpace(formIconoUrl) ? null : formIconoUrl.Trim()
                };

                ok = await CategoriaService.CrearAsync(dto);
            }

            if (ok)
            {
                mostrarModal = false;
                Snackbar.Add(esEdicion ? "Categoría actualizada correctamente." : "Categoría creada con éxito.", Severity.Success);
                categorias = await CategoriaService.ObtenerTodasAsync(soloActivas);
            }
            else
            {
                mensajeError = esEdicion
                    ? "No se pudo actualizar. Verificá los datos o permisos."
                    : "No se pudo crear la categoría.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarCategoria(int id)
    {
        var ok = await CategoriaService.EliminarAsync(id);
        if (ok)
        {
            Snackbar.Add("Categoría eliminada.", Severity.Info);
            categorias = await CategoriaService.ObtenerTodasAsync(soloActivas);
        }
        else
        {
            Snackbar.Add("No se pudo eliminar la categoría.", Severity.Error);
        }
    }
}