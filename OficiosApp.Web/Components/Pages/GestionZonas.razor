@page "/admin/zonas"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using OficiosApp.Shared.Dtos.Zonas
@using OficiosApp.Web.Services
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IZonaService ZonaService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Gestión de Zonas — OficiosApp</PageTitle>

<MudThemeProvider Theme="AdminTheme" IsDarkMode="true" />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        @{
            var idRol = context.User.FindFirst("IdRol")?.Value;
            if (idRol != "1")
            {
                Navigation.NavigateTo("/explorar");
            }
        }

        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8 pb-16 minimal-bg">

            <!-- Header con Acción Principal -->
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.End" Class="mb-10 flex-wrap gap-4">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.overline" Style="color: var(--mud-palette-warning); letter-spacing: 2px; font-weight: 600;">
                        Módulo Admin
                    </MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: 800; letter-spacing: -1px; color: #f8fafc;">
                        Zonas de Cobertura
                    </MudText>
                    <MudText Typo="Typo.subtitle1" Style="color: #94a3b8; font-weight: 300;">
                        Administrá las áreas geográficas y códigos postales donde operan los profesionales.
                    </MudText>
                </MudStack>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Rounded.AddLocationAlt"
                           OnClick="AbrirModalCreacion"
                           Class="px-5 py-2"
                           Style="border-radius: 10px; font-weight: 700; text-transform: none; color: #05080f;">
                    Nueva Zona
                </MudButton>
            </MudStack>

            <!-- Filtros y Métricas -->
            <MudPaper Class="pa-4 mb-8 filter-bar rounded-xl" Elevation="0" Outlined="true">
                <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="filtroTexto"
                                      Placeholder="Buscar por barrio, ciudad o código postal..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Rounded.Search"
                                      IconSize="Size.Medium"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Style="background-color: #05080f; border-radius: 8px;" />
                    </MudItem>

                    <MudItem xs="12" md="6" Class="d-flex justify-end align-center flex-wrap gap-3">
                        <MudSwitch T="bool"
                                   Value="soloActivas"
                                   ValueChanged="OnSoloActivasChanged"
                                   Color="Color.Success"
                                   Label="Solo activas"
                                   Style="color: #cbd5e1;" />

                        <MudChip T="string" Color="Color.Dark" Style="border: 1px solid #1e293b; background-color: #0f172a;">
                            Total: <strong class="ms-1" style="color: #f8fafc;">@zonasFiltradas.Count</strong>
                        </MudChip>

                        <MudChip T="string" Style="background-color: rgba(16, 185, 129, 0.1); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.2);">
                            Activas: <strong class="ms-1">@zonasFiltradas.Count(z => z.Activa)</strong>
                        </MudChip>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Grilla de Zonas -->
            @if (cargando)
            {
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-16">
                    <MudProgressCircular Color="Color.Warning" Indeterminate="true" Size="Size.Large" />
                    <MudText Typo="Typo.body2" Style="color: #64748b;" Class="mt-4">Cargando zonas de cobertura...</MudText>
                </MudStack>
            }
            else if (!zonasFiltradas.Any())
            {
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-16">
                    <MudIcon Icon="@Icons.Material.Rounded.LocationOff" Size="Size.Large" Style="color: #334155; font-size: 4rem;" />
                    <MudText Typo="Typo.h6" Style="color: #f8fafc;" Class="mt-4">No se encontraron zonas</MudText>
                    <MudText Typo="Typo.body2" Style="color: #64748b;">Podés registrar una nueva zona geográfica con el botón superior.</MudText>
                </MudStack>
            }
            else
            {
                <MudGrid Spacing="4">
                    @foreach (var z in zonasFiltradas)
                    {
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudPaper Class="pa-5 zone-card rounded-xl d-flex flex-column" Elevation="0" Outlined="true" Style="height: 100%;">

                                <!-- Icono y Estado -->
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-3">
                                    <MudAvatar Style="background: linear-gradient(135deg, #1e293b, #0f172a); border: 1px solid #334155; color: #f59e0b;" Size="Size.Large">
                                        <MudIcon Icon="@Icons.Material.Rounded.Place" Size="Size.Medium" />
                                    </MudAvatar>

                                    @if (z.Activa)
                                    {
                                        <MudChip T="string" Size="Size.Small" Style="background-color: rgba(16, 185, 129, 0.1); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.2); font-weight: 600;">
                                            Activa
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Style="background-color: rgba(239, 68, 68, 0.1); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2); font-weight: 600;">
                                            Inactiva
                                        </MudChip>
                                    }
                                </MudStack>

                                <!-- Datos de la Zona -->
                                <MudText Typo="Typo.caption" Style="color: #64748b; font-family: monospace;">ID #@z.IdZona</MudText>
                                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc; line-height: 1.2;" Class="mb-3 text-truncate" title="@z.Nombre">
                                    @z.Nombre
                                </MudText>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-6">
                                    <MudIcon Icon="@Icons.Material.Rounded.MarkunreadMailbox" Size="Size.Small" Style="color: #64748b;" />
                                    @if (!string.IsNullOrWhiteSpace(z.CodigoPostal))
                                    {
                                        <MudText Typo="Typo.caption" Style="color: #cbd5e1; font-family: monospace; background-color: #0f172a; border: 1px solid #1e293b; padding: 2px 8px; border-radius: 6px;">
                                            CP: @z.CodigoPostal
                                        </MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Style="color: #64748b;">Sin código postal</MudText>
                                    }
                                </MudStack>

                                <!-- Acciones -->
                                <MudStack Row="true" Spacing="2" Class="mt-auto pt-4" Style="border-top: 1px solid rgba(255,255,255,0.05);">
                                    <MudButton Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Rounded.Edit"
                                               Class="flex-grow-1 action-btn"
                                               OnClick="@(() => AbrirModalEdicion(z))">
                                        Editar
                                    </MudButton>
                                    <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline"
                                                   Variant="Variant.Outlined"
                                                   Class="danger-btn"
                                                   Title="Eliminar zona"
                                                   OnClick="@(() => EliminarZona(z.IdZona))" />
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudContainer>

        <!-- Modal con MudOverlay (Evita el fallo de circuito de MudDialogProvider) -->
        <MudOverlay Visible="mostrarModal" DarkBackground="true" Absolute="false" ZIndex="1300">
            <MudPaper Class="pa-6 modal-paper rounded-xl" Outlined="true" Elevation="24" Style="width: 92vw; max-width: 480px;">

                <!-- Encabezado del Modal -->
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-4 mb-4" Style="border-bottom: 1px solid #1e293b;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@(esEdicion ? Icons.Material.Rounded.EditLocationAlt : Icons.Material.Rounded.AddLocationAlt)"
                                 Style="color: #f59e0b;" />
                        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc;">
                            @(esEdicion ? "Editar Zona" : "Nueva Zona")
                        </MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" OnClick="CerrarModal" Style="color: #94a3b8;" />
                </MudStack>

                <!-- Cuerpo del Modal -->
                <MudStack Spacing="4" Class="mb-6 text-start">
                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Style="border-radius: 8px;">
                            @mensajeError
                        </MudAlert>
                    }

                    <MudTextField @bind-Value="formNombre"
                                  Label="Nombre de la Zona / Ciudad / Barrio *"
                                  Placeholder="Ej: Centro, Villa Santillán, Zona Norte"
                                  MaxLength="100"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Style="background-color: #05080f;" />

                    <MudTextField @bind-Value="formCodigoPostal"
                                  Label="Código Postal (opcional, máx 10)"
                                  Placeholder="Ej: 6300"
                                  MaxLength="10"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Style="background-color: #05080f;" />

                    @if (esEdicion)
                    {
                        <MudSwitch @bind-Value="formActiva"
                                   Color="Color.Success"
                                   Label="Zona Activa en la Plataforma"
                                   Style="color: #cbd5e1;" />
                    }
                </MudStack>

                <!-- Acciones del Modal -->
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="pt-4" Style="border-top: 1px solid #1e293b;">
                    <MudButton OnClick="CerrarModal" Disabled="@guardando" Style="color: #94a3b8; text-transform: none;">
                        Cancelar
                    </MudButton>
                    <MudButton Color="Color.Warning"
                               Variant="Variant.Filled"
                               OnClick="GuardarZona"
                               Disabled="@guardando"
                               Style="font-weight: 700; color: #05080f; text-transform: none; border-radius: 8px;">
                        @if (guardando)
                        {
                            <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true" Style="color: #05080f;" />
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>@(esEdicion ? "Guardar Cambios" : "Crear Zona")</span>
                        }
                    </MudButton>
                </MudStack>

            </MudPaper>
        </MudOverlay>

    </Authorized>
</AuthorizeView>

<style>
    body {
        background-color: #05080f;
        color: #f8fafc;
    }

    .minimal-bg {
        background-color: #05080f;
        min-height: 100vh;
    }

    .filter-bar {
        background-color: #0b0f19 !important;
        border-color: #1e293b !important;
    }

    .zone-card {
        background-color: #0b0f19 !important;
        border-color: #1e293b !important;
        transition: all 0.2s ease-in-out;
    }

        .zone-card:hover {
            border-color: #334155 !important;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.5) !important;
        }

    .modal-paper {
        background-color: #0b0f19 !important;
        border-color: #334155 !important;
    }

    .action-btn {
        border-color: #334155 !important;
        color: #e2e8f0 !important;
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 8px !important;
    }

        .action-btn:hover {
            background-color: #1e293b !important;
            color: #ffffff !important;
        }

    .danger-btn {
        border-color: #334155 !important;
        color: #ef4444 !important;
        border-radius: 8px !important;
    }

        .danger-btn:hover {
            background-color: rgba(239, 68, 68, 0.1) !important;
            border-color: rgba(239, 68, 68, 0.3) !important;
        }

    /* === ALTO CONTRASTE UNIFICADO PARA TODOS LOS INPUTS === */
    .mud-input-control > .mud-input-control-input-container > div.mud-input.mud-input-outlined {
        background-color: #1e293b !important;
        border-radius: 8px !important;
    }

    .mud-input-outlined-border {
        border-color: #475569 !important;
        border-width: 1.5px !important;
    }

    .mud-input-control:hover .mud-input-outlined-border {
        border-color: #94a3b8 !important;
    }

    .mud-input.mud-input-outlined.mud-input-focused .mud-input-outlined-border {
        border-color: #f59e0b !important;
        border-width: 2px !important;
    }

    .mud-input > input.mud-input-root,
    .mud-input > textarea.mud-input-root,
    div.mud-input-slot.mud-input-root {
        color: #ffffff !important;
        font-weight: 500 !important;
    }

        .mud-input > input.mud-input-root::placeholder,
        .mud-input > textarea.mud-input-root::placeholder {
            color: #94a3b8 !important;
            opacity: 1 !important;
        }

    .mud-input-label {
        color: #e2e8f0 !important;
        font-weight: 600 !important;
        background-color: transparent !important;
    }

    .mud-input-control.mud-input-focused .mud-input-label {
        color: #f59e0b !important;
    }

    .mud-input-adornment .mud-icon-root,
    .mud-input-adornment button {
        color: #cbd5e1 !important;
    }
</style>

@code {
    private MudTheme AdminTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#f59e0b",           // Ámbar para foco de inputs y acentos principales
            Secondary = "#3b82f6",         // Azul secundario
            Success = "#10b981",           // Verde estados activos
            Warning = "#f59e0b",           // Ámbar botones principales
            Error = "#ef4444",             // Rojo errores y bajas
            Background = "#05080f",        // Fondo general de pantalla (body)
            Surface = "#0b0f19",           // Fondo de tarjetas y modales
            AppbarBackground = "#05080f",
            TextPrimary = "#ffffff",       // Texto dentro de los inputs en blanco puro
            TextSecondary = "#e2e8f0",     // Labels de los inputs bien claros
            LinesDefault = "#475569",      // Bordes generales visibles
            LinesInputs = "#64748b",       // Bordes de inputs
            ActionDefault = "#cbd5e1"      // Íconos de inputs
        }
    };

    private List<ZonaResponseDto> zonas = new();
    private string filtroTexto = string.Empty;
    private bool soloActivas = false;
    private bool cargando = true;
    private bool guardando = false;

    private bool mostrarModal = false;
    private bool esEdicion = false;
    private int idSeleccionado = 0;
    private string formNombre = string.Empty;
    private string? formCodigoPostal;
    private bool formActiva = true;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        await CargarZonas();
    }

    private async Task OnSoloActivasChanged(bool valor)
    {
        soloActivas = valor;
        await CargarZonas();
    }

    private async Task CargarZonas()
    {
        cargando = true;
        try
        {
            zonas = await ZonaService.ObtenerTodasAsync(soloActivas);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al consultar zonas: {ex.Message}");
            zonas = new List<ZonaResponseDto>();
        }
        finally
        {
            cargando = false;
        }
    }

    private List<ZonaResponseDto> zonasFiltradas
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filtroTexto))
                return zonas;

            var f = filtroTexto.Trim().ToLower();
            return zonas.Where(z =>
                (z.Nombre != null && z.Nombre.ToLower().Contains(f)) ||
                (z.CodigoPostal != null && z.CodigoPostal.ToLower().Contains(f))
            ).ToList();
        }
    }

    private void AbrirModalCreacion()
    {
        esEdicion = false;
        idSeleccionado = 0;
        formNombre = string.Empty;
        formCodigoPostal = null;
        formActiva = true;
        mensajeError = null;
        mostrarModal = true;
    }

    private void AbrirModalEdicion(ZonaResponseDto zona)
    {
        esEdicion = true;
        idSeleccionado = zona.IdZona;
        formNombre = zona.Nombre;
        formCodigoPostal = zona.CodigoPostal;
        formActiva = zona.Activa;
        mensajeError = null;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        mensajeError = null;
    }

    private async Task GuardarZona()
    {
        if (string.IsNullOrWhiteSpace(formNombre))
        {
            mensajeError = "El nombre de la zona es obligatorio.";
            return;
        }

        guardando = true;
        mensajeError = null;

        try
        {
            bool ok;
            if (esEdicion)
            {
                var dto = new ActualizarZonaDto
                {
                    Nombre = formNombre.Trim(),
                    CodigoPostal = string.IsNullOrWhiteSpace(formCodigoPostal) ? null : formCodigoPostal.Trim(),
                    Activa = formActiva
                };

                ok = await ZonaService.ActualizarAsync(idSeleccionado, dto);
            }
            else
            {
                var dto = new CrearZonaDto
                {
                    Nombre = formNombre.Trim(),
                    CodigoPostal = string.IsNullOrWhiteSpace(formCodigoPostal) ? null : formCodigoPostal.Trim()
                };

                ok = await ZonaService.CrearAsync(dto);
            }

            if (ok)
            {
                mostrarModal = false;
                Snackbar.Add(esEdicion ? "Zona actualizada correctamente." : "Zona creada con éxito.", Severity.Success);
                zonas = await ZonaService.ObtenerTodasAsync(soloActivas);
            }
            else
            {
                mensajeError = esEdicion
                    ? "No se pudo actualizar la zona. Verificá los datos o permisos."
                    : "No se pudo crear la zona.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarZona(int id)
    {
        var ok = await ZonaService.EliminarAsync(id);
        if (ok)
        {
            Snackbar.Add("Zona eliminada.", Severity.Info);
            zonas = await ZonaService.ObtenerTodasAsync(soloActivas);
        }
        else
        {
            Snackbar.Add("No se pudo eliminar la zona.", Severity.Error);
        }
    }
}