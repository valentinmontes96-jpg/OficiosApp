@page "/profesional/{IdProfesional:int}"
@using OficiosApp.Shared.Dtos.Categoria
@using OficiosApp.Shared.Dtos.Citas
@using OficiosApp.Shared.Dtos.HorariosAtencion
@using OficiosApp.Shared.Dtos.Profesionales
@using OficiosApp.Shared.Dtos.Zonas
@using OficiosApp.Mobile.Services
@inject IProfesionalMobileService ProfesionalService
@inject ICategoriaService CategoriaService
@inject ICitaMobileService CitaService
@inject NavigationManager Nav

<div class="h-full flex flex-col bg-slate-50">
    <!-- Header -->
    <header class="bg-blue-600 text-white px-4 py-3.5 shadow-md z-10 flex items-center gap-3">
        <button type="button"
                @onclick="Volver"
                class="p-1.5 rounded-lg hover:bg-blue-700 active:bg-blue-800 transition-colors">
            ←
        </button>
        <div>
            <h1 class="text-base font-extrabold">Perfil del Profesional</h1>
            <p class="text-[11px] text-blue-100">Detalle y solicitud de servicio</p>
        </div>
    </header>

    <main class="p-4 flex-1 overflow-y-auto space-y-4">
        @if (cargando)
        {
            <div class="flex flex-col justify-center items-center py-14 bg-white rounded-2xl border border-gray-100">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mb-3"></div>
                <span class="text-gray-500 text-xs font-medium">Cargando perfil profesional...</span>
            </div>
        }
        else if (profesional == null)
        {
            <div class="bg-white p-6 rounded-2xl text-center shadow-sm border border-gray-200">
                <p class="text-gray-700 text-sm font-bold mb-2">Profesional no encontrado</p>
                <button type="button"
                        @onclick='() => Nav.NavigateTo("/home-cliente")'
                        class="px-4 py-2 bg-blue-600 text-white rounded-xl text-xs font-bold">
                    Volver al inicio
                </button>
            </div>
        }
        else
        {
            <!-- Tarjeta principal del profesional -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-200 space-y-3">
                <div class="flex items-center gap-3.5">
                    <div class="w-14 h-14 rounded-2xl bg-blue-600 text-white font-black text-lg flex items-center justify-center shrink-0">
                        @(profesional.Nombre?.FirstOrDefault())@(profesional.Apellido?.FirstOrDefault())
                    </div>
                    <div class="flex-1 min-w-0">
                        <h2 class="text-base font-extrabold text-gray-900 truncate">@profesional.Nombre @profesional.Apellido</h2>
                        @if (profesional.DisponibleUrgencia)
                        {
                            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-red-600 bg-red-50 px-2.5 py-0.5 rounded-full mt-0.5">
                                🚨 Disponible Urgencias 24/7
                            </span>
                        }
                        else
                        {
                            <span class="text-xs text-gray-500 block">Atención con cita programada</span>
                        }
                    </div>
                </div>

                <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                    <span class="text-xs font-semibold text-gray-600">Tarifa base de referencia</span>
                    <span class="text-sm font-black text-blue-700">
                        @(profesional.TarifaBase.HasValue ? $"${profesional.TarifaBase.Value:N0}" : "A convenir")
                    </span>
                </div>

                <div>
                    <h3 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Presentación</h3>
                    <p class="text-xs text-gray-600 leading-relaxed">
                        @(string.IsNullOrWhiteSpace(profesional.Biografia)
                            ? "Profesional verificado en la plataforma OficiosApp."
                            : profesional.Biografia)
                    </p>
                </div>

                @if (NombresCategorias.Any())
                {
                    <div>
                        <h3 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Especialidades</h3>
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var cat in NombresCategorias)
                            {
                                <span class="text-xs font-semibold bg-blue-50 text-blue-700 px-2.5 py-1 rounded-lg">
                                    🛠️ @cat
                                </span>
                            }
                        </div>
                    </div>
                }

                @if (NombresZonas.Any())
                {
                    <div>
                        <h3 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Zonas de cobertura</h3>
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var zona in NombresZonas)
                            {
                                <span class="text-xs font-semibold bg-slate-100 text-slate-700 px-2.5 py-1 rounded-lg">
                                    📍 @zona
                                </span>
                            }
                        </div>
                    </div>
                }

                @if (horarios.Any())
                {
                    <div>
                        <h3 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Horarios de atención</h3>
                        <div class="space-y-1">
                            @foreach (var h in horarios)
                            {
                                <div class="flex justify-between text-xs text-gray-600 bg-slate-50 px-2.5 py-1.5 rounded-lg">
                                    <span class="font-semibold">@NombreDia(h.DiaSemana)</span>
                                    <span>@h.HoraApertura.ToString(@"hh\:mm") a @h.HoraCierre.ToString(@"hh\:mm") hs</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Formulario para Agendar Cita / Solicitar Servicio -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-200 space-y-3 pb-6">
                <h3 class="text-sm font-extrabold text-gray-900">
                    📅 Solicitar Cita con @profesional.Nombre
                </h3>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Fecha y hora deseada</label>
                    <input type="datetime-local"
                           @bind="fechaPactada"
                           class="w-full p-2.5 rounded-xl border border-gray-300 text-xs outline-none focus:border-blue-500 bg-white" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Dirección del servicio</label>
                    <input type="text"
                           @bind="direccionServicio"
                           placeholder="Ej: Av. San Martín 450, Piso 2"
                           class="w-full p-2.5 rounded-xl border border-gray-300 text-xs outline-none focus:border-blue-500 bg-white" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Descripción del problema o trabajo</label>
                    <textarea rows="3"
                              @bind="descripcionProblema"
                              placeholder="Describí brevemente qué necesitás reparar o instalar..."
                              class="w-full p-2.5 rounded-xl border border-gray-300 text-xs outline-none focus:border-blue-500 bg-white"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(mensajeFeedback))
                {
                    <div class="p-3 rounded-xl text-xs font-semibold @(exitoEnvio ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-red-50 text-red-600 border border-red-200")">
                        @mensajeFeedback
                    </div>
                }

                <button type="button"
                        disabled="@enviando"
                        @onclick="ConfirmarSolicitudCita"
                        class="w-full py-3 bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-extrabold rounded-xl text-xs shadow-sm transition-all disabled:opacity-50">
                    @(enviando ? "Enviando solicitud..." : "Confirmar Solicitud de Cita")
                </button>
            </div>
        }
    </main>
</div>

@code {
    [Parameter] public int IdProfesional { get; set; }

    private ProfesionalResponseDto? profesional;
    private List<CategoriaResponseDto> categorias = new();
    private List<ZonaResponseDto> zonas = new();
    private List<HorarioAtencionResponseDto> horarios = new();

    private DateTime fechaPactada = DateTime.Now.AddDays(1).Date.AddHours(10);
    private string direccionServicio = string.Empty;
    private string descripcionProblema = string.Empty;

    private bool cargando = true;
    private bool enviando = false;
    private bool exitoEnvio = false;
    private string? mensajeFeedback;

    private List<string> NombresCategorias =>
        profesional?.IdsCategorias
            .Select(id => categorias.FirstOrDefault(c => c.IdCategoria == id)?.Nombre)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Select(n => n!)
            .ToList() ?? new();

    private List<string> NombresZonas =>
        profesional?.IdsZonas
            .Select(id => zonas.FirstOrDefault(z => z.IdZona == id)?.Nombre)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Select(n => n!)
            .ToList() ?? new();

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        var tareaPro = ProfesionalService.ObtenerPerfilAsync(IdProfesional);
        var tareaCats = CategoriaService.ObtenerCategoriasAsync();
        var tareaZonas = ProfesionalService.ObtenerZonasAsync();
        var tareaHorarios = ProfesionalService.ObtenerHorariosAsync(IdProfesional);

        profesional = await tareaPro;
        categorias = await tareaCats;
        zonas = await tareaZonas;
        horarios = await tareaHorarios;
        cargando = false;
    }

    private async Task ConfirmarSolicitudCita()
    {
        mensajeFeedback = null;
        if (string.IsNullOrWhiteSpace(direccionServicio) || string.IsNullOrWhiteSpace(descripcionProblema))
        {
            exitoEnvio = false;
            mensajeFeedback = "Por favor completá la dirección y la descripción del trabajo.";
            return;
        }

        enviando = true;
        var dto = new CrearCitaDto
        {
            IdUsuarioProfesional = IdProfesional,
            FechaServicioPactada = fechaPactada,
            DireccionServicio = direccionServicio.Trim(),
            DescripcionProblema = descripcionProblema.Trim()
        };

        var (exito, mensaje) = await CitaService.CrearCitaAsync(dto);
        enviando = false;
        exitoEnvio = exito;
        mensajeFeedback = mensaje;

        if (exito)
        {
            await Task.Delay(900);
            Nav.NavigateTo("/citas");
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/explorar");
    }

    private static string NombreDia(byte dia) => dia switch
    {
        0 => "Domingo",
        1 => "Lunes",
        2 => "Martes",
        3 => "Miércoles",
        4 => "Jueves",
        5 => "Viernes",
        6 => "Sábado",
        _ => $"Día {dia}"
    };
}

