@page "/mis-zonas"
@using OficiosApp.Shared.Dtos.Zonas
@using OficiosApp.Mobile.Services
@inject IProfesionalMobileService ProfesionalService
@inject IAuthService AuthService
@inject NavigationManager Nav

<div class="h-full flex flex-col bg-slate-50">
    <header class="bg-slate-900 text-white px-4 py-3.5 shadow-md z-10 flex items-center gap-3">
        <button type="button"
                @onclick='() => Nav.NavigateTo("/home-profesional")'
                class="p-1.5 rounded-lg hover:bg-slate-800 active:bg-slate-700 transition-colors">
            ←
        </button>
        <div>
            <h1 class="text-base font-extrabold leading-tight">Mis Zonas de Cobertura</h1>
            <p class="text-[11px] text-slate-300">Barrios y localidades donde realizás visitas</p>
        </div>
    </header>

    <main class="p-4 flex-1 overflow-y-auto space-y-4">
        @if (cargando)
        {
            <div class="flex flex-col justify-center items-center py-14 bg-white rounded-2xl border border-gray-100">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-slate-800 mb-3"></div>
                <span class="text-gray-500 text-xs font-medium">Cargando zonas...</span>
            </div>
        }
        else if (zonas.Count == 0)
        {
            <div class="bg-white p-6 rounded-2xl text-center shadow-sm border border-gray-200">
                <p class="text-gray-700 text-sm font-bold">No hay zonas cargadas en el sistema.</p>
            </div>
        }
        else
        {
            <div class="space-y-2.5">
                @foreach (var zona in zonas)
                {
                    var seleccionada = seleccionadas.Contains(zona.IdZona);

                    <div @onclick="() => AlternarZona(zona.IdZona)"
                         class="p-3.5 rounded-2xl border cursor-pointer transition-all flex items-center justify-between gap-3 @(seleccionada ? "bg-amber-50 border-amber-500 shadow-sm" : "bg-white border-gray-200")">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl flex items-center justify-center text-lg @(seleccionada ? "bg-amber-500 text-slate-950" : "bg-slate-100 text-slate-700")">
                                📍
                            </div>
                            <div>
                                <h3 class="text-sm font-bold text-gray-900">@zona.Nombre</h3>
                                @if (!string.IsNullOrWhiteSpace(zona.CodigoPostal))
                                {
                                    <span class="text-[11px] text-gray-500">CP: @zona.CodigoPostal</span>
                                }
                            </div>
                        </div>

                        <div class="w-6 h-6 rounded-full border-2 flex items-center justify-center text-xs font-extrabold @(seleccionada ? "bg-amber-500 border-amber-500 text-slate-950" : "border-gray-300 text-transparent")">
                            ✓
                        </div>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="p-3 rounded-xl text-xs font-bold @(exito ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-red-50 text-red-600 border border-red-200")">
                    @mensaje
                </div>
            }

            <div class="pb-6">
                <button type="button"
                        disabled="@guardando"
                        @onclick="GuardarZonas"
                        class="w-full py-3 bg-slate-900 hover:bg-slate-800 active:scale-95 text-amber-400 font-extrabold rounded-xl text-xs shadow-sm transition-all disabled:opacity-50">
                    @(guardando ? "Guardando..." : $"Guardar Zonas ({seleccionadas.Count} seleccionadas)")
                </button>
            </div>
        }
    </main>
</div>

@code {
    private List<ZonaResponseDto> zonas = new();
    private HashSet<int> seleccionadas = new();
    private bool cargando = true;
    private bool guardando = false;
    private bool exito = false;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        var idUsuario = await AuthService.ObtenerIdUsuarioAsync();
        zonas = await ProfesionalService.ObtenerZonasAsync();

        if (idUsuario.HasValue)
        {
            var perfil = await ProfesionalService.ObtenerPerfilAsync(idUsuario.Value);
            if (perfil?.IdsZonas != null)
            {
                seleccionadas = perfil.IdsZonas.ToHashSet();
            }
        }

        cargando = false;
    }

    private void AlternarZona(int idZona)
    {
        if (!seleccionadas.Remove(idZona))
            seleccionadas.Add(idZona);
    }

    private async Task GuardarZonas()
    {
        guardando = true;
        mensaje = null;

        exito = await ProfesionalService.AsignarZonasAsync(seleccionadas.ToList());
        guardando = false;

        mensaje = exito
            ? "¡Tus zonas de cobertura fueron actualizadas!"
            : "Error al guardar zonas. Asegurate de haber guardado primero tu Perfil Profesional.";
    }
}

