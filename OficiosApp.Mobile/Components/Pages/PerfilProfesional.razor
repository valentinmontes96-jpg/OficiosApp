@page "/perfil-profesional"
@using OficiosApp.Shared.Dtos.Profesionales
@using OficiosApp.Mobile.Services
@inject IProfesionalMobileService ProfesionalService
@inject IAuthService AuthService
@inject NavigationManager Nav

<div class="h-full flex flex-col bg-slate-50">
    <header class="bg-slate-900 text-white px-4 py-3.5 shadow-md z-10 flex items-center gap-3">
        <button type="button"
                @onclick='() => Nav.NavigateTo("/home-profesional")'
                class="p-1.5 rounded-lg hover:bg-slate-800 active:bg-slate-700 transition-colors">
            ←
        </button>
        <div>
            <h1 class="text-base font-extrabold leading-tight">Mi Perfil Profesional</h1>
            <p class="text-[11px] text-slate-300">Configurá tu presentación, tarifa y guardia</p>
        </div>
    </header>

    <main class="p-4 flex-1 overflow-y-auto space-y-4">
        @if (cargando)
        {
            <div class="flex flex-col justify-center items-center py-14 bg-white rounded-2xl border border-gray-100">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-slate-800 mb-3"></div>
                <span class="text-gray-500 text-xs font-medium">Cargando tus datos...</span>
            </div>
        }
        else
        {
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-200 space-y-4">
                <div class="flex items-center gap-3 pb-3 border-b border-gray-100">
                    <div class="w-12 h-12 rounded-2xl bg-slate-900 text-amber-400 font-black text-base flex items-center justify-center">
                        @(nombreUsuario?.FirstOrDefault() ?? 'P')
                    </div>
                    <div>
                        <h2 class="text-sm font-extrabold text-gray-900">@(string.IsNullOrWhiteSpace(nombreUsuario) ? "Profesional" : nombreUsuario)</h2>
                        <span class="text-xs text-gray-500">Perfil visible para clientes</span>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Tarifa Base de Referencia ($)</label>
                    <input type="number"
                           step="500"
                           min="0"
                           @bind="modelo.TarifaBase"
                           placeholder="Ej: 15000"
                           class="w-full p-3 rounded-xl border border-gray-300 text-xs outline-none focus:border-slate-800 bg-white" />
                    <span class="text-[11px] text-gray-400 mt-1 block">Monto orientativo por visita o presupuesto inicial.</span>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Biografía / Presentación Profesional</label>
                    <textarea rows="4"
                              @bind="modelo.Biografia"
                              placeholder="Contales a los clientes tu experiencia, matrícula, años en el rubro y garantías..."
                              class="w-full p-3 rounded-xl border border-gray-300 text-xs outline-none focus:border-slate-800 bg-white"></textarea>
                </div>

                <div class="p-3.5 rounded-xl bg-slate-50 border border-gray-200 flex items-center justify-between">
                    <div>
                        <span class="text-xs font-extrabold text-gray-800 block">Disponible para Urgencias 24/7 🚨</span>
                        <span class="text-[11px] text-gray-500">Aparecer en el listado de emergencias inmediatas</span>
                    </div>
                    <input type="checkbox"
                           @bind="modelo.DisponibleUrgencia"
                           class="w-5 h-5 rounded text-emerald-600 focus:ring-emerald-500" />
                </div>

                @if (!string.IsNullOrEmpty(mensaje))
                {
                    <div class="p-3 rounded-xl text-xs font-bold @(guardadoExitoso ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-red-50 text-red-600 border border-red-200")">
                        @mensaje
                    </div>
                }

                <button type="button"
                        disabled="@guardando"
                        @onclick="GuardarCambios"
                        class="w-full py-3 bg-slate-900 hover:bg-slate-800 active:scale-95 text-amber-400 font-extrabold rounded-xl text-xs shadow-sm transition-all disabled:opacity-50">
                    @(guardando ? "Guardando..." : "Guardar Perfil Profesional")
                </button>
            </div>
        }
    </main>
</div>

@code {
    private ActualizarProfesionalDto modelo = new();
    private string? nombreUsuario;
    private int? idUsuario;
    private bool cargando = true;
    private bool guardando = false;
    private bool guardadoExitoso = false;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        nombreUsuario = await AuthService.ObtenerNombreUsuarioAsync();
        idUsuario = await AuthService.ObtenerIdUsuarioAsync();

        if (idUsuario.HasValue)
        {
            var perfil = await ProfesionalService.ObtenerPerfilAsync(idUsuario.Value);
            if (perfil != null)
            {
                modelo.Biografia = perfil.Biografia;
                modelo.TarifaBase = perfil.TarifaBase;
                modelo.DisponibleUrgencia = perfil.DisponibleUrgencia;
            }
        }

        cargando = false;
    }

    private async Task GuardarCambios()
    {
        guardando = true;
        mensaje = null;

        var resultado = await ProfesionalService.ActualizarPerfilAsync(modelo);
        guardando = false;

        if (resultado != null)
        {
            guardadoExitoso = true;
            mensaje = "¡Perfil profesional actualizado correctamente!";
        }
        else
        {
            guardadoExitoso = false;
            mensaje = "No se pudo guardar el perfil. Verificá tu conexión.";
        }
    }
}

