@page "/urgencias"
@using OficiosApp.Shared.Dtos.Categoria
@using OficiosApp.Shared.Dtos.Profesionales
@using OficiosApp.Mobile.Services
@inject IProfesionalMobileService ProfesionalService
@inject ICategoriaService CategoriaService
@inject NavigationManager Nav

<div class="h-full flex flex-col bg-slate-50">
    <!-- Header Urgencias -->
    <header class="bg-red-600 text-white px-4 py-3.5 shadow-md z-10 flex items-center gap-3">
        <button type="button"
                @onclick='() => Nav.NavigateTo("/home-cliente")'
                class="p-1.5 rounded-lg hover:bg-red-700 active:bg-red-800 transition-colors">
            ←
        </button>
        <div>
            <div class="flex items-center gap-1.5">
                <span>🚨</span>
                <h1 class="text-base font-extrabold">Urgencias 24/7</h1>
            </div>
            <p class="text-[11px] text-red-100">Profesionales con guardia activa en este momento</p>
        </div>
    </header>

    <main class="p-4 flex-1 overflow-y-auto space-y-4">
        <!-- Filtro por rubro -->
        <div class="flex gap-2 overflow-x-auto pb-1">
            <button type="button"
                    @onclick="() => idCategoriaSeleccionada = 0"
                    class="px-3 py-1.5 rounded-full text-xs font-bold shrink-0 transition-all @(idCategoriaSeleccionada == 0 ? "bg-red-600 text-white shadow-sm" : "bg-white text-gray-700 border border-gray-200")">
                Todos (@profesionalesGuardia.Count)
            </button>
            @foreach (var cat in categorias)
            {
                <button type="button"
                        @onclick="() => idCategoriaSeleccionada = cat.IdCategoria"
                        class="px-3 py-1.5 rounded-full text-xs font-bold shrink-0 transition-all @(idCategoriaSeleccionada == cat.IdCategoria ? "bg-red-600 text-white shadow-sm" : "bg-white text-gray-700 border border-gray-200")">
                    @cat.Nombre
                </button>
            }
        </div>

        @if (cargando)
        {
            <div class="flex flex-col justify-center items-center py-14 bg-white rounded-2xl border border-gray-100">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-red-600 mb-3"></div>
                <span class="text-gray-500 text-xs font-medium">Buscando guardias activas...</span>
            </div>
        }
        else if (ProfesionalesMostrados.Count == 0)
        {
            <div class="bg-white p-6 rounded-2xl text-center shadow-sm border border-gray-200">
                <span class="text-3xl block mb-2">🌙</span>
                <p class="text-gray-800 text-sm font-bold mb-1">Sin guardias activas en este rubro</p>
                <p class="text-gray-500 text-xs mb-4">Podés explorar todos los profesionales para agendar una visita programada.</p>
                <button type="button"
                        @onclick='() => Nav.NavigateTo("/explorar")'
                        class="px-4 py-2 bg-blue-600 text-white rounded-xl text-xs font-bold">
                    Explorar todos los profesionales
                </button>
            </div>
        }
        else
        {
            <div class="space-y-3 pb-6">
                @foreach (var pro in ProfesionalesMostrados)
                {
                    <div class="bg-white p-4 rounded-2xl shadow-sm border border-red-200 space-y-3">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-center gap-3">
                                <div class="w-11 h-11 rounded-full bg-red-600 text-white font-extrabold text-sm flex items-center justify-center shrink-0">
                                    @(pro.Nombre?.FirstOrDefault())@(pro.Apellido?.FirstOrDefault())
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-900 text-sm">@pro.Nombre @pro.Apellido</h3>
                                    <span class="inline-flex items-center gap-1 text-[10px] font-extrabold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
                                        ● Disponible ahora
                                    </span>
                                </div>
                            </div>

                            <div class="text-right">
                                <span class="text-[10px] text-gray-400 uppercase font-semibold block">Tarifa Base</span>
                                <span class="text-sm font-extrabold text-gray-900">
                                    @(pro.TarifaBase.HasValue ? $"${pro.TarifaBase.Value:N0}" : "A convenir")
                                </span>
                            </div>
                        </div>

                        <p class="text-xs text-gray-600 line-clamp-2">
                            @(string.IsNullOrWhiteSpace(pro.Biografia)
                                ? "Atención inmediata de emergencias y reparaciones urgentes."
                                : pro.Biografia)
                        </p>

                        <button type="button"
                                @onclick='() => Nav.NavigateTo($"/profesional/{pro.IdUsuario}?urgencia=true")'
                                class="w-full py-2.5 bg-red-600 hover:bg-red-700 active:scale-95 text-white font-extrabold rounded-xl text-xs transition-all">
                            🚨 Solicitar Atención de Urgencia
                        </button>
                    </div>
                }
            </div>
        }
    </main>
</div>

@code {
    private List<ProfesionalResponseDto> profesionalesGuardia = new();
    private List<CategoriaResponseDto> categorias = new();
    private int idCategoriaSeleccionada = 0;
    private bool cargando = true;

    private List<ProfesionalResponseDto> ProfesionalesMostrados =>
        idCategoriaSeleccionada == 0
            ? profesionalesGuardia
            : profesionalesGuardia.Where(p => p.IdsCategorias != null && p.IdsCategorias.Contains(idCategoriaSeleccionada)).ToList();

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        var todos = await ProfesionalService.ObtenerTodosAsync();
        profesionalesGuardia = todos.Where(p => p.DisponibleUrgencia).ToList();
        categorias = await CategoriaService.ObtenerCategoriasAsync();
        cargando = false;
    }
}

