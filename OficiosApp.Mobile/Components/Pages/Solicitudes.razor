@page "/solicitudes"
@page "/citas"
@using OficiosApp.Shared.Dtos.Citas
@using OficiosApp.Shared.Dtos.Citas.Response
@using OficiosApp.Shared.Dtos.Profesionales
@using OficiosApp.Mobile.Services
@inject ICitaMobileService CitaService
@inject IProfesionalMobileService ProfesionalService
@inject IAuthService AuthService
@inject NavigationManager Nav

<div class="h-full flex flex-col bg-slate-50">
    <!-- Header Citas Cliente -->
    <header class="bg-blue-600 text-white px-4 py-3.5 shadow-md z-10 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <button type="button"
                    @onclick='() => Nav.NavigateTo("/home-cliente")'
                    class="p-1.5 rounded-lg hover:bg-blue-700 active:bg-blue-800 transition-colors">
                ←
            </button>
            <div>
                <h1 class="text-base font-extrabold leading-tight">Mis Citas</h1>
                <p class="text-[11px] text-blue-100">Seguimiento de tus turnos y contrataciones</p>
            </div>
        </div>

        <button type="button"
                @onclick='() => Nav.NavigateTo("/explorar")'
                class="px-3 py-1.5 bg-white text-blue-700 font-extrabold rounded-xl text-xs shadow-sm active:scale-95 transition-all">
            + Nueva Cita
        </button>
    </header>

    <main class="p-4 flex-1 overflow-y-auto space-y-4">
        <!-- Control de segmentos -->
        <div class="grid grid-cols-2 bg-gray-200/80 p-1 rounded-xl">
            <button type="button"
                    @onclick='() => pestanaActiva = "encurso"'
                    class="py-2 rounded-lg text-xs font-bold transition-all @(pestanaActiva == "encurso" ? "bg-white text-gray-900 shadow-sm" : "text-gray-600")">
                En curso (@CitasEnCurso.Count)
            </button>
            <button type="button"
                    @onclick='() => pestanaActiva = "finalizadas"'
                    class="py-2 rounded-lg text-xs font-bold transition-all @(pestanaActiva == "finalizadas" ? "bg-white text-gray-900 shadow-sm" : "text-gray-600")">
                Finalizadas (@CitasFinalizadas.Count)
            </button>
        </div>

        @if (cargando)
        {
            <div class="flex flex-col justify-center items-center py-14 bg-white rounded-2xl border border-gray-100">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mb-3"></div>
                <span class="text-gray-500 text-xs font-medium">Cargando tus citas...</span>
            </div>
        }
        else if (CitasMostradas.Count == 0)
        {
            <div class="bg-white p-6 rounded-2xl text-center shadow-sm border border-gray-200">
                <span class="text-3xl block mb-2">📅</span>
                <p class="text-gray-800 text-sm font-bold mb-1">
                    @(pestanaActiva == "encurso" ? "No tenés citas en curso" : "No tenés citas finalizadas")
                </p>
                <p class="text-gray-500 text-xs mb-4">
                    Explorá las categorías o profesionales disponibles para agendar un servicio.
                </p>
                <button type="button"
                        @onclick='() => Nav.NavigateTo("/home-cliente")'
                        class="px-4 py-2.5 bg-blue-600 text-white rounded-xl text-xs font-bold">
                    Buscar Profesionales
                </button>
            </div>
        }
        else
        {
            <div class="space-y-3 pb-6">
                @foreach (var cita in CitasMostradas)
                {
                    var nombrePro = ObtenerNombreProfesional(cita.IdUsuarioProfesional);
                    var tarifaPro = ObtenerTarifaProfesional(cita.IdUsuarioProfesional);

                    <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-200 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold @ObtenerClaseBadgeEstado(cita.IdEstadoCita)">
                                @ObtenerNombreEstado(cita.IdEstadoCita)
                            </span>
                            <span class="text-xs text-gray-500 font-semibold">
                                📅 @cita.FechaServicioPactada.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>

                        <div>
                            <h2 class="text-sm font-extrabold text-gray-900 leading-snug">@cita.DescripcionProblema</h2>
                            <p class="text-xs text-gray-600 mt-1">
                                👷 Profesional: <strong class="text-gray-800">@nombrePro</strong>
                            </p>
                            <p class="text-xs text-gray-500 mt-0.5">
                                📍 Dirección: @cita.DireccionServicio
                            </p>
                        </div>

                        <div class="pt-2.5 border-t border-gray-100 flex items-center justify-between gap-2">
                            <span class="text-[11px] text-gray-500 font-medium">
                                @(tarifaPro.HasValue ? $"Tarifa base: ${tarifaPro.Value:N0}" : $"Solicitud #{cita.IdCita}")
                            </span>

                            <div class="flex items-center gap-2">
                                <button type="button"
                                        @onclick="() => VerHistorial(cita)"
                                        class="px-3 py-1.5 rounded-lg border border-gray-200 bg-slate-50 text-gray-700 text-xs font-bold hover:bg-gray-100">
                                    Ver Detalle
                                </button>

                                @if (cita.IdEstadoCita == 1 || cita.IdEstadoCita == 2)
                                {
                                    <button type="button"
                                            disabled="@procesando"
                                            @onclick="() => CancelarCitaCliente(cita.IdCita)"
                                            class="px-3 py-1.5 rounded-lg bg-red-50 text-red-600 border border-red-200 text-xs font-bold hover:bg-red-100 disabled:opacity-50">
                                        Cancelar
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </main>

    <!-- Modal de Detalle e Historial de la Cita -->
    @if (citaSeleccionada != null)
    {
        <div class="fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center p-3">
            <div class="bg-white w-full max-w-md rounded-2xl p-4 shadow-xl space-y-3 max-h-[80vh] overflow-y-auto">
                <div class="flex items-center justify-between border-b border-gray-100 pb-2.5">
                    <div>
                        <h3 class="text-sm font-extrabold text-gray-900">Detalle de Cita #@citaSeleccionada.IdCita</h3>
                        <span class="text-[11px] text-gray-500">Solicitada el @citaSeleccionada.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <button type="button"
                            @onclick="CerrarModalDetalle"
                            class="p-1.5 text-gray-400 hover:text-gray-700 font-bold text-sm">
                        ✕
                    </button>
                </div>

                <div class="bg-slate-50 p-3 rounded-xl space-y-1 text-xs">
                    <p><strong>Profesional:</strong> @ObtenerNombreProfesional(citaSeleccionada.IdUsuarioProfesional)</p>
                    <p><strong>Fecha pactada:</strong> @citaSeleccionada.FechaServicioPactada.ToString("dd/MM/yyyy HH:mm") hs</p>
                    <p><strong>Dirección:</strong> @citaSeleccionada.DireccionServicio</p>
                    <p><strong>Trabajo:</strong> @citaSeleccionada.DescripcionProblema</p>
                </div>

                <div>
                    <h4 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Historial de Estados</h4>
                    @if (cargandoHistorial)
                    {
                        <p class="text-xs text-gray-500 py-3 text-center">Cargando historial...</p>
                    }
                    else if (historialCita.Count == 0)
                    {
                        <p class="text-xs text-gray-500 py-2">Sin movimientos adicionales registrados.</p>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var h in historialCita)
                            {
                                <div class="border-l-2 border-blue-500 pl-3 py-1 text-xs">
                                    <div class="flex justify-between font-bold text-gray-800">
                                        <span>@h.NombreEstado</span>
                                        <span class="text-[10px] text-gray-400">@h.FechaCambio.ToString("dd/MM HH:mm")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(h.Observaciones))
                                    {
                                        <p class="text-gray-600 text-[11px] mt-0.5">@h.Observaciones</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <button type="button"
                        @onclick="CerrarModalDetalle"
                        class="w-full py-2.5 bg-gray-900 text-white rounded-xl text-xs font-bold">
                    Cerrar
                </button>
            </div>
        </div>
    }
</div>

@code {
    private List<CitaResponseDto> citas = new();
    private List<ProfesionalResponseDto> profesionales = new();
    private string pestanaActiva = "encurso";
    private bool cargando = true;
    private bool procesando = false;

    private CitaResponseDto? citaSeleccionada;
    private List<HistorialEstadoCitaResponseDto> historialCita = new();
    private bool cargandoHistorial = false;

    private List<CitaResponseDto> CitasEnCurso =>
        citas.Where(c => c.IdEstadoCita == 1 || c.IdEstadoCita == 2).ToList();

    private List<CitaResponseDto> CitasFinalizadas =>
        citas.Where(c => c.IdEstadoCita == 3 || c.IdEstadoCita == 4).ToList();

    private List<CitaResponseDto> CitasMostradas =>
        pestanaActiva == "encurso" ? CitasEnCurso : CitasFinalizadas;

    protected override async Task OnInitializedAsync()
    {
        var idRol = await AuthService.ObtenerIdRolAsync();
        if (idRol == 3)
        {
            Nav.NavigateTo("/solicitudes-profesional", replace: true);
            return;
        }

        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        cargando = true;
        var tareaCitas = CitaService.ObtenerMisCitasClienteAsync();
        var tareaPros = ProfesionalService.ObtenerTodosAsync();

        citas = await tareaCitas;
        profesionales = await tareaPros;
        cargando = false;
    }

    private async Task CancelarCitaCliente(int idCita)
    {
        procesando = true;
        var ok = await CitaService.CambiarEstadoCitaAsync(idCita, 3, "Cita cancelada por el cliente.");
        if (ok)
        {
            citas = await CitaService.ObtenerMisCitasClienteAsync();
        }
        procesando = false;
    }

    private async Task VerHistorial(CitaResponseDto cita)
    {
        citaSeleccionada = cita;
        cargandoHistorial = true;
        historialCita = await CitaService.ObtenerHistorialCitaAsync(cita.IdCita);
        cargandoHistorial = false;
    }

    private void CerrarModalDetalle()
    {
        citaSeleccionada = null;
        historialCita.Clear();
    }

    private string ObtenerNombreProfesional(int idProfesional)
    {
        var pro = profesionales.FirstOrDefault(p => p.IdUsuario == idProfesional);
        return pro != null ? $"{pro.Nombre} {pro.Apellido}".Trim() : $"Profesional #{idProfesional}";
    }

    private decimal? ObtenerTarifaProfesional(int idProfesional) =>
        profesionales.FirstOrDefault(p => p.IdUsuario == idProfesional)?.TarifaBase;

    private static string ObtenerNombreEstado(int idEstado) => idEstado switch
    {
        1 => "Pendiente de visita",
        2 => "Confirmada",
        3 => "Cancelada",
        4 => "Completada",
        _ => $"Estado #{idEstado}"
    };

    private static string ObtenerClaseBadgeEstado(int idEstado) => idEstado switch
    {
        1 => "bg-amber-100 text-amber-800",
        2 => "bg-blue-100 text-blue-800",
        3 => "bg-red-100 text-red-700",
        4 => "bg-emerald-100 text-emerald-800",
        _ => "bg-gray-100 text-gray-700"
    };
}