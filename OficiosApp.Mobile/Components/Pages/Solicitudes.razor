@page "/solicitudes"

<div class="screen-container">
    <div>
        <h1 class="title-lg">Mis Solicitudes</h1>
        <p class="text-muted">Historial y estado de tus contrataciones</p>
    </div>

    <div class="segment-control">
        <button class="segment-btn active">En curso</button>
        <button class="segment-btn">Finalizadas</button>
    </div>

    <div class="cards-list">
        <div class="card">
            <div class="card-header-row">
                <span class="badge badge-pending">Pendiente de visita</span>
                <span class="text-muted" style="font-size: 0.75rem;">10 Nov 2026</span>
            </div>

            <h2 class="card-title">Reparación de pérdida en cocina</h2>
            <span class="text-muted">Profesional: Roberto Benítez</span>

            <div class="card-footer-row">
                <span class="text-muted" style="font-size: 0.75rem;">Presupuesto estimado: $25.000</span>
                <button class="btn-sm" style="background:#ffffff; color:#111827; border:1px solid #e5e7eb;">Ver Detalle</button>
            </div>
        </div>
    </div>
</div>

<style>
    .segment-control {
        display: flex;
        background: #e5e7eb;
        border-radius: 8px;
        padding: 2px;
    }

    .segment-btn {
        flex: 1;
        height: 36px;
        border: none;
        background: transparent;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--text-muted);
        border-radius: 6px;
    }

        .segment-btn.active {
            background: #ffffff;
            color: var(--text-main);
            font-weight: 600;
            box-shadow: 0 1px 2px rgba(0,0,0,0.06);
        }
</style>