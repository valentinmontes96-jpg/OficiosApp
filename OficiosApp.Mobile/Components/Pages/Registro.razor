@page "/registro"
@layout EmptyLayout
@using OficiosApp.Mobile.Services
@using OficiosApp.Shared.Dtos.Auth.Register.Request
@inject IAuthService AuthService
@inject NavigationManager Nav

<div class="min-h-full flex flex-col justify-center items-center bg-gray-100 p-4 py-8">
    <div class="w-full max-w-md bg-white p-6 rounded-2xl shadow-md border border-gray-200">

        <!-- Encabezado -->
        <div class="text-center mb-6">
            <h1 class="text-2xl font-black text-blue-600 tracking-wide">Crear Cuenta</h1>
            <p class="text-xs text-gray-500 mt-1">Completá tus datos para unirte a OficiosApp</p>
        </div>

        <EditForm Model="@modelo" OnValidSubmit="ProcesarRegistro">
            <DataAnnotationsValidator />

            <!-- Selector de Tipo de Cuenta: 2 = Cliente, 3 = Profesional -->
            <div class="mb-4">
                <label class="block text-xs font-semibold text-gray-700 mb-2">¿Cómo vas a usar la app?</label>
                <div class="grid grid-cols-2 gap-3">
                    <button type="button"
                            @onclick="() => SeleccionarRol(2)"
                            class="p-3 rounded-xl border text-center transition-all @(modelo.IdRol == 2 ? "border-blue-600 bg-blue-50 text-blue-700 font-bold shadow-sm" : "border-gray-200 bg-white text-gray-600")">
                        <span class="text-2xl block mb-1">👤</span>
                        <span class="text-xs">Soy Cliente</span>
                    </button>
                    <button type="button"
                            @onclick="() => SeleccionarRol(3)"
                            class="p-3 rounded-xl border text-center transition-all @(modelo.IdRol == 3 ? "border-blue-600 bg-blue-50 text-blue-700 font-bold shadow-sm" : "border-gray-200 bg-white text-gray-600")">
                        <span class="text-2xl block mb-1">🛠️</span>
                        <span class="text-xs">Soy Profesional</span>
                    </button>
                </div>
            </div>

            <div class="space-y-3">
                <!-- Nombre y Apellido -->
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-[11px] font-semibold text-gray-600 mb-1">Nombre</label>
                        <InputText @bind-Value="modelo.Nombre"
                                   placeholder="Juan"
                                   class="w-full p-2.5 rounded-lg border border-gray-300 text-xs outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-200 bg-white" />
                        <ValidationMessage For="@(() => modelo.Nombre)" class="text-[10px] text-red-500 mt-0.5" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-gray-600 mb-1">Apellido</label>
                        <InputText @bind-Value="modelo.Apellido"
                                   placeholder="Pérez"
                                   class="w-full p-2.5 rounded-lg border border-gray-300 text-xs outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-200 bg-white" />
                        <ValidationMessage For="@(() => modelo.Apellido)" class="text-[10px] text-red-500 mt-0.5" />
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-[11px] font-semibold text-gray-600 mb-1">Email</label>
                    <InputText @bind-Value="modelo.Email"
                               type="email"
                               placeholder="juanperez@ejemplo.com"
                               class="w-full p-2.5 rounded-lg border border-gray-300 text-xs outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-200 bg-white" />
                    <ValidationMessage For="@(() => modelo.Email)" class="text-[10px] text-red-500 mt-0.5" />
                </div>

                <!-- Teléfono -->
                <div>
                    <label class="block text-[11px] font-semibold text-gray-600 mb-1">Teléfono</label>
                    <InputText @bind-Value="modelo.Telefono"
                               placeholder="Ej: 2954123456"
                               class="w-full p-2.5 rounded-lg border border-gray-300 text-xs outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-200 bg-white" />
                    <ValidationMessage For="@(() => modelo.Telefono)" class="text-[10px] text-red-500 mt-0.5" />
                </div>

                <!-- Contraseña -->
                <div>
                    <label class="block text-[11px] font-semibold text-gray-600 mb-1">Contraseña</label>
                    <InputText @bind-Value="modelo.Password"
                               type="password"
                               placeholder="Mínimo 6 caracteres"
                               class="w-full p-2.5 rounded-lg border border-gray-300 text-xs outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-200 bg-white" />
                    <ValidationMessage For="@(() => modelo.Password)" class="text-[10px] text-red-500 mt-0.5" />
                </div>
            </div>

            <!-- Feedback de Error -->
            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="mt-4 p-3 rounded-lg bg-red-50 border border-red-200 text-red-600 text-xs">
                    @mensajeError
                </div>
            }

            <!-- Feedback de Éxito -->
            @if (registroExitoso)
            {
                <div class="mt-4 p-3 rounded-lg bg-green-50 border border-green-200 text-green-700 text-xs">
                    ¡Cuenta creada exitosamente! Redirigiendo...
                </div>
            }

            <!-- Botón de Envío -->
            <button type="submit"
                    disabled="@cargando"
                    class="w-full mt-5 py-3 bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-bold rounded-lg shadow-sm transition-all disabled:opacity-60 text-xs flex justify-center items-center">
                @if (cargando)
                {
                    <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                    <span>Creando cuenta...</span>
                }
                else
                {
                    <span>Registrarme</span>
                }
            </button>
        </EditForm>

        <!-- Redirección a Login -->
        <div class="mt-5 text-center text-xs text-gray-600">
            ¿Ya tenés una cuenta?
            <a href="/" class="text-blue-600 font-semibold hover:underline">Iniciá sesión acá</a>
        </div>
    </div>
</div>

@code {
    // Por defecto inicia seleccionado en 2 (Cliente)
    private RegisterRequestDto modelo = new() { IdRol = 2 };
    private string mensajeError = string.Empty;
    private bool cargando = false;
    private bool registroExitoso = false;

    private void SeleccionarRol(int idRol)
    {
        modelo.IdRol = idRol;
    }

    private async Task ProcesarRegistro()
    {
        cargando = true;
        mensajeError = string.Empty;

        var (exito, mensaje) = await AuthService.RegisterAsync(modelo);
        cargando = false;

        if (exito)
        {
            registroExitoso = true;
            StateHasChanged();
            await Task.Delay(1200);
            Nav.NavigateTo("/", replace: true);
        }
        else
        {
            mensajeError = mensaje;
        }
    }
}