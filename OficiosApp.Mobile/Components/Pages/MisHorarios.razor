@page "/mis-horarios"
@using OficiosApp.Shared.Dtos.HorariosAtencion
@using OficiosApp.Mobile.Services
@inject IProfesionalMobileService ProfesionalService
@inject IAuthService AuthService
@inject NavigationManager Nav

<div class="h-full flex flex-col bg-slate-50">
    <header class="bg-slate-900 text-white px-4 py-3.5 shadow-md z-10 flex items-center gap-3">
        <button type="button"
                @onclick='() => Nav.NavigateTo("/home-profesional")'
                class="p-1.5 rounded-lg hover:bg-slate-800 active:bg-slate-700 transition-colors">
            ←
        </button>
        <div>
            <h1 class="text-base font-extrabold leading-tight">Mis Horarios de Atención</h1>
            <p class="text-[11px] text-slate-300">Configurá tus días y franjas horarias</p>
        </div>
    </header>

    <main class="p-4 flex-1 overflow-y-auto space-y-4">
        @if (cargando)
        {
            <div class="flex flex-col justify-center items-center py-14 bg-white rounded-2xl border border-gray-100">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-slate-800 mb-3"></div>
                <span class="text-gray-500 text-xs font-medium">Cargando horarios...</span>
            </div>
        }
        else
        {
            <div class="space-y-2.5">
                @foreach (var dia in diasSemana)
                {
                    <div class="bg-white p-3.5 rounded-2xl shadow-sm border @(dia.Activo ? "border-amber-400" : "border-gray-200") space-y-2.5">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-bold text-gray-900">@dia.Nombre</span>
                            <label class="flex items-center gap-2 text-xs font-semibold text-gray-600 cursor-pointer">
                                <input type="checkbox" @bind="dia.Activo" class="w-4 h-4 rounded text-amber-500" />
                                <span>@(dia.Activo ? "Atiende" : "Cerrado")</span>
                            </label>
                        </div>

                        @if (dia.Activo)
                        {
                            <div class="grid grid-cols-2 gap-2 pt-1 border-t border-gray-100">
                                <div>
                                    <label class="block text-[10px] font-semibold text-gray-500 mb-0.5">Desde</label>
                                    <input type="time"
                                           value="@dia.AperturaTexto"
                                           @onchange="(e) => ActualizarApertura(dia, e.Value?.ToString())"
                                           class="w-full p-2 rounded-lg border border-gray-200 text-xs bg-slate-50" />
                                </div>
                                <div>
                                    <label class="block text-[10px] font-semibold text-gray-500 mb-0.5">Hasta</label>
                                    <input type="time"
                                           value="@dia.CierreTexto"
                                           @onchange="(e) => ActualizarCierre(dia, e.Value?.ToString())"
                                           class="w-full p-2 rounded-lg border border-gray-200 text-xs bg-slate-50" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="p-3 rounded-xl text-xs font-bold @(exito ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-red-50 text-red-600 border border-red-200")">
                    @mensaje
                </div>
            }

            <div class="pb-6">
                <button type="button"
                        disabled="@guardando"
                        @onclick="GuardarSemana"
                        class="w-full py-3 bg-slate-900 hover:bg-slate-800 active:scale-95 text-amber-400 font-extrabold rounded-xl text-xs shadow-sm transition-all disabled:opacity-50">
                    @(guardando ? "Sincronizando horarios..." : "Guardar Horarios de la Semana")
                </button>
            </div>
        }
    </main>
</div>

@code {
    private class DiaConfig
    {
        public byte DiaSemana { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public bool Activo { get; set; }
        public string AperturaTexto { get; set; } = "08:00";
        public string CierreTexto { get; set; } = "18:00";
    }

    private List<DiaConfig> diasSemana = new()
    {
        new() { DiaSemana = 1, Nombre = "Lunes", Activo = true },
        new() { DiaSemana = 2, Nombre = "Martes", Activo = true },
        new() { DiaSemana = 3, Nombre = "Miércoles", Activo = true },
        new() { DiaSemana = 4, Nombre = "Jueves", Activo = true },
        new() { DiaSemana = 5, Nombre = "Viernes", Activo = true },
        new() { DiaSemana = 6, Nombre = "Sábado", Activo = false },
        new() { DiaSemana = 0, Nombre = "Domingo", Activo = false }
    };

    private bool cargando = true;
    private bool guardando = false;
    private bool exito = false;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        var idUsuario = await AuthService.ObtenerIdUsuarioAsync();
        if (idUsuario.HasValue)
        {
            var existentes = await ProfesionalService.ObtenerHorariosAsync(idUsuario.Value);
            if (existentes.Any())
            {
                foreach (var d in diasSemana)
                {
                    var match = existentes.FirstOrDefault(x => x.DiaSemana == d.DiaSemana);
                    if (match != null)
                    {
                        d.Activo = true;
                        d.AperturaTexto = match.HoraApertura.ToString(@"hh\:mm");
                        d.CierreTexto = match.HoraCierre.ToString(@"hh\:mm");
                    }
                    else
                    {
                        d.Activo = false;
                    }
                }
            }
        }

        cargando = false;
    }

    private static void ActualizarApertura(DiaConfig dia, string? valor) =>
        dia.AperturaTexto = string.IsNullOrWhiteSpace(valor) ? "08:00" : valor;

    private static void ActualizarCierre(DiaConfig dia, string? valor) =>
        dia.CierreTexto = string.IsNullOrWhiteSpace(valor) ? "18:00" : valor;

    private async Task GuardarSemana()
    {
        guardando = true;
        mensaje = null;

        var lista = new List<CrearOActualizarHorarioDto>();
        foreach (var d in diasSemana.Where(x => x.Activo))
        {
            if (TimeSpan.TryParse(d.AperturaTexto, out var apertura) && TimeSpan.TryParse(d.CierreTexto, out var cierre))
            {
                lista.Add(new CrearOActualizarHorarioDto
                {
                    DiaSemana = d.DiaSemana,
                    HoraApertura = apertura,
                    HoraCierre = cierre
                });
            }
        }

        exito = await ProfesionalService.SincronizarHorariosAsync(lista);
        guardando = false;

        mensaje = exito
            ? "¡Horarios de atención actualizados correctamente!"
            : "No se pudieron guardar los horarios. Verificá que la hora de cierre sea posterior a la de apertura.";
    }
}
