@page "/login"
@layout Layout.EmptyLayout
@using OficiosApp.Shared.Dtos.Auth.Login.Request
@using OficiosApp.Mobile.Services
@inject NavigationManager Nav
@inject IAuthService AuthService

<div class="h-full flex flex-col bg-blue-600 text-white justify-center px-6">
    <h1 class="text-4xl font-bold text-center mb-2">HogarFix</h1>
    <p class="text-center mb-10 text-blue-200">Encuentra a tu profesional</p>

    <input type="email"
           @bind="loginDto.Email"
           placeholder="Correo electrónico"
           class="w-full p-3 mb-4 rounded text-black outline-none focus:ring-2 focus:ring-white">

    <input type="password"
           @bind="loginDto.Password"
           placeholder="Contraseña"
           class="w-full p-3 mb-2 rounded text-black outline-none focus:ring-2 focus:ring-white">

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <p class="text-red-200 text-sm mb-4 text-center font-medium bg-red-700/50 p-2 rounded">
            @mensajeError
        </p>
    }
    else
    {
        <div class="h-6 mb-2"></div>
    }

    <button @onclick="IniciarSesion"
            disabled="@cargando"
            class="w-full bg-white text-blue-600 font-bold p-3 rounded mb-4 hover:bg-gray-100 shadow-lg transition-transform active:scale-95 disabled:opacity-70">
        @(cargando ? "Iniciando..." : "Iniciar Sesión")
    </button>

    <div class="text-center mt-6 border-t border-blue-400 pt-6">
        <span class="text-blue-100 text-sm block mb-2">¿Sos nuevo en HogarFix?</span>
        <button @onclick='() => Nav.NavigateTo("/registro")'
                class="w-full bg-transparent border-2 border-white text-white font-bold p-3 rounded hover:bg-white hover:text-blue-600 transition-colors active:scale-95">
            Crear Cuenta nueva
        </button>
    </div>
</div>

@code {
    private LoginRequestDto loginDto = new();
    private bool cargando = false;
    private string mensajeError = string.Empty;

    private async Task IniciarSesion()
    {
        if (string.IsNullOrWhiteSpace(loginDto.Email) || string.IsNullOrWhiteSpace(loginDto.Password))
        {
            mensajeError = "Completá todos los campos.";
            return;
        }

        cargando = true;
        mensajeError = string.Empty;

        bool exito = await AuthService.LoginAsync(loginDto);

        if (exito)
        {
            Nav.NavigateTo("/");
        }
        else
        {
            mensajeError = "Credenciales inválidas o error de conexión.";
        }

        cargando = false;
    }
}