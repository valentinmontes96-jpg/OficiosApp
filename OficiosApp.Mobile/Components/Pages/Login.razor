@page "/"
@page "/login"
@using OficiosApp.Mobile.Services
@layout EmptyLayout
@using OficiosApp.Shared.Dtos.Auth.Login.Request
@inject IAuthService AuthService
@inject NavigationManager Nav

<div class="min-h-full flex flex-col justify-center items-center bg-gray-100 p-6">
    <div class="w-full max-w-sm bg-white p-6 rounded-2xl shadow-md border border-gray-200">
        <div class="text-center mb-6">
            <h1 class="text-2xl font-black text-blue-600 tracking-wide">OficiosApp</h1>
            <p class="text-sm text-gray-500 mt-1">Iniciá sesión para continuar</p>
        </div>

        <div class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Email</label>
                <input type="email"
                       @bind="credenciales.Email"
                       placeholder="usuario@ejemplo.com"
                       class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 bg-white text-gray-800 text-sm" />
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Contraseña</label>
                <input type="password"
                       @bind="credenciales.Password"
                       placeholder="••••••••"
                       class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 bg-white text-gray-800 text-sm" />
            </div>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="p-3 rounded-lg bg-red-50 text-red-600 text-xs border border-red-200">
                    @mensajeError
                </div>
            }

            <button @onclick="EjecutarLogin"
                    disabled="@cargando"
                    class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg shadow-sm transition-all active:scale-95 disabled:opacity-60 text-sm flex justify-center items-center">
                @if (cargando)
                {
                    <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                    <span>Ingresando...</span>
                }
                else
                {
                    <span>Iniciar sesión</span>
                }
            </button>
        </div>

        <div class="mt-6 text-center text-xs text-gray-600">
            ¿No tenés cuenta?
            <a href="/registro" class="text-blue-600 font-semibold hover:underline">Registrate acá</a>
        </div>
    </div>
</div>

@code {
    private LoginRequestDto credenciales = new();
    private string mensajeError = string.Empty;
    private bool cargando = false;

    /*protected override async Task OnInitializedAsync()
    {
        
        var estaAutenticado = await AuthService.IsAuthenticatedAsync();
        if (estaAutenticado)
        {
            Nav.NavigateTo("/home", replace: true);
        }
    }*/

    private async Task EjecutarLogin()
    {
        if (string.IsNullOrWhiteSpace(credenciales.Email) || string.IsNullOrWhiteSpace(credenciales.Password))
        {
            mensajeError = "Por favor, ingresá email y contraseña.";
            return;
        }

        cargando = true;
        mensajeError = string.Empty;

        var loginExitoso = await AuthService.LoginAsync(credenciales);

        cargando = false;

        if (loginExitoso)
        {
            var rutaDestino = await AuthService.ObtenerRutaHomePorRolAsync();
            Nav.NavigateTo(rutaDestino, replace: true);
        }
        else
        {
            mensajeError = "Credenciales incorrectas o problema de conexión con el servidor.";
        }
    }
}