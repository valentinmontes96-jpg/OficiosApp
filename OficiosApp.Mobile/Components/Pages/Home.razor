@page "/"
@using OficiosApp.Shared.Dtos.Categoria
@using OficiosApp.Mobile.Services
@inject ICategoriaService CategoriaService
@inject NavigationManager Nav

<div class="h-full flex flex-col bg-gray-100">
    <div class="bg-blue-600 text-white p-4 text-center font-bold text-lg shadow-md z-10">
        ¿Qué necesitas arreglar?
    </div>

    <div class="p-4 flex-1 overflow-y-auto">
        <input type="text"
               placeholder="Buscar (ej. Plomero)..."
               class="w-full p-3 mb-6 rounded-lg border border-gray-300 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 bg-white text-black">

        <button class="w-full bg-red-600 text-white font-bold p-4 rounded-xl mb-6 shadow-lg hover:bg-red-700 animate-pulse transition-transform active:scale-95">
            <span class="block text-base tracking-wide font-extrabold">URGENCIA 24/7</span>
            <span class="text-xs font-normal opacity-90">Ver disponibles ahora</span>
        </button>

        <h2 class="font-bold mb-3 text-gray-700">Categorías</h2>

        @if (cargando)
        {
            <div class="flex justify-center items-center py-12">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                <span class="ml-3 text-gray-600 text-sm">Cargando categorías...</span>
            </div>
        }
        else if (categorias.Count == 0)
        {
            <div class="bg-white p-6 rounded-xl text-center shadow-sm border border-gray-200">
                <p class="text-gray-500 text-sm">No se encontraron categorías disponibles.</p>
                <button @onclick="CargarCategorias" class="mt-3 text-blue-600 font-semibold text-sm hover:underline">
                    Reintentar
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-2 gap-4 pb-6">
                @foreach (var cat in categorias)
                {
                    <div @onclick="() => VerCategoria(cat.IdCategoria)"
                         class="bg-white p-4 rounded-xl shadow-sm text-center cursor-pointer hover:bg-blue-50 border border-transparent hover:border-blue-200 transition-all active:scale-95 flex flex-col items-center justify-center min-h-[110px]">

                        @if (!string.IsNullOrWhiteSpace(cat.IconoUrl))
                        {
                            <img src="@cat.IconoUrl" alt="@cat.Nombre" class="w-9 h-9 object-contain mb-2" />
                        }
                        else
                        {
                            <div class="w-9 h-9 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm mb-2">
                                @cat.Nombre.Substring(0, Math.Min(2, cat.Nombre.Length)).ToUpper()
                            </div>
                        }

                        <span class="font-semibold text-gray-800 text-sm">@cat.Nombre</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<CategoriaResponseDto> categorias = new();
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }

    private async Task CargarCategorias()
    {
        cargando = true;
        categorias = await CategoriaService.ObtenerCategoriasAsync();
        cargando = false;
    }

    private void VerCategoria(int idCategoria)
    {
        Nav.NavigateTo($"/resultados/{idCategoria}");
    }
}